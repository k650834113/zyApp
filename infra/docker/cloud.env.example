NODE_ENV=development
DEPLOYMENT_ENVIRONMENT=test
API_PORT=3100
POSTGRES_DB=zyapp_test
POSTGRES_USER=zyapp
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgres://zyapp:local-development-only@postgres:5432/zyapp_test
REDIS_URL=redis://redis:6379
DEVICE_ENROLLMENT_SECRET=replace-this-local-secret-before-first-enrollment
DESKTOP_UPDATE_DIRECTORY=/app/updates/windows
PHONE_VERIFICATION_SECRET=replace-this-local-phone-verification-secret
PHONE_VERIFICATION_MODE=mock
WECHAT_PAYMENT_MODE=mock
MINIAPP_DEVELOPMENT_AUTH_ENABLED=true
MINIAPP_WECHAT_AUTH_MODE=mock
# Set the next two values and MINIAPP_WECHAT_AUTH_MODE=wechat for real wx.login/getPhoneNumber integration.
WECHAT_MINIAPP_APP_ID=
WECHAT_MINIAPP_APP_SECRET=
# Test deployment only; requires MINIAPP_WECHAT_AUTH_MODE=wechat.
MINIAPP_TEST_VIRTUAL_PHONE=
BGG_METADATA_MODE=disabled
BGG_XML_API_TOKEN_FILE=/run/secrets/bgg/xml-api-token
BGG_PUBLIC_IMAGES_ENABLED=false
BGG_SECRETS_DIRECTORY=/opt/zyapp/secrets/bgg
WORKER_QUEUE_NAME=zyapp-maintenance
