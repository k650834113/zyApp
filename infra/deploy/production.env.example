APP_DOMAIN=
CADDYFILE_PATH=./Caddyfile
ACME_CA=https://acme-v02.api.letsencrypt.org/directory
POSTGRES_DB=zyapp
TEST_POSTGRES_DB=zyapp_test
POSTGRES_USER=zyapp
POSTGRES_PASSWORD=replace-with-url-safe-random-secret
DATABASE_URL=postgres://zyapp:replace-with-the-same-postgres-secret@postgres:5432/zyapp
TEST_DATABASE_URL=postgres://zyapp:replace-with-the-same-postgres-secret@postgres:5432/zyapp_test
REDIS_PASSWORD=replace-with-url-safe-random-secret
REDIS_URL=redis://:replace-with-the-same-redis-secret@redis:6379/0
TEST_REDIS_URL=redis://:replace-with-the-same-redis-secret@redis:6379/1
DEVICE_ENROLLMENT_SECRET=replace-with-at-least-32-random-characters
TEST_DEVICE_ENROLLMENT_SECRET=replace-with-a-different-32-character-secret
PHONE_VERIFICATION_SECRET=replace-with-at-least-32-random-characters
TEST_PHONE_VERIFICATION_SECRET=replace-with-a-different-32-character-secret
MINIAPP_WECHAT_AUTH_MODE=wechat
TEST_MINIAPP_WECHAT_AUTH_MODE=wechat
WECHAT_MINIAPP_APP_ID=replace-with-mini-program-appid
WECHAT_MINIAPP_APP_SECRET=replace-with-server-side-mini-program-appsecret
# Temporary test-only switch. Remove after WeChat phone capability is approved.
TEST_MINIAPP_VIRTUAL_PHONE=18888888888
WORKER_QUEUE_NAME=zyapp-maintenance
TEST_WORKER_QUEUE_NAME=zyapp-maintenance-test
