{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@zyapp/contracts": ["packages/contracts/src/index.ts"],
      "@zyapp/domain": ["packages/domain/src/index.ts"],
      "@zyapp/auth": ["packages/auth/src/index.ts"],
      "@zyapp/module-registry": ["packages/module-registry/src/index.ts"],
      "@zyapp/local-db": ["packages/local-db/src/index.ts"],
      "@zyapp/cloud-db": ["packages/cloud-db/src/index.ts"],
      "@zyapp/observability": ["packages/observability/src/index.ts"],
      "@zyapp/sync-protocol": ["packages/sync-protocol/src/index.ts"]
    }
  }
}
