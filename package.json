{
  "name": "zyapp",
  "version": "0.24.0",
  "private": true,
  "description": "Board-game shop desktop management and cashier system",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @zyapp/merchant-desktop dev",
    "cloud:build": "pnpm --filter @zyapp/cloud-db build && pnpm --filter @zyapp/api build && pnpm --filter @zyapp/worker build",
    "cloud:migrate": "pnpm --filter @zyapp/cloud-db migrate",
    "cloud:up": "powershell -NoProfile -ExecutionPolicy Bypass -File ./infra/scripts/cloud-up.ps1",
    "cloud:down": "powershell -NoProfile -ExecutionPolicy Bypass -File ./infra/scripts/cloud-down.ps1",
    "cloud:status": "powershell -NoProfile -ExecutionPolicy Bypass -File ./infra/scripts/cloud-status.ps1",
    "miniapp:build": "pnpm --filter @zyapp/miniapp build",
    "miniapp:build:production": "pnpm --filter @zyapp/miniapp build:production",
    "miniapp:dev": "pnpm --filter @zyapp/miniapp dev",
    "miniapp:test": "pnpm --filter @zyapp/miniapp test",
    "miniapp:typecheck": "pnpm --filter @zyapp/miniapp typecheck",
    "release:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File ./infra/scripts/prepare-desktop-release.ps1",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm test:release-contract && vitest run",
    "test:release-contract": "node --test infra/scripts/test-release-contract.mjs",
    "test:watch": "vitest",
    "package:win": "powershell -NoProfile -ExecutionPolicy Bypass -File ./infra/scripts/package-win.ps1"
  },
  "devDependencies": {
    "@types/node": "24.13.1",
    "typescript": "5.9.3",
    "vitest": "4.1.8"
  }
}
