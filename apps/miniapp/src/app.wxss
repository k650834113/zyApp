page {
  min-height: 100%;
  color: #1e2b26;
  background: #fbf7ef;
  font-family: -apple-system, BlinkMacSystemFont, "Microsoft YaHei", sans-serif;
}

button::after {
  border: 0;
}

.page-shell {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 28rpx 28rpx 150rpx;
}

.card {
  box-sizing: border-box;
  border: 1rpx solid #e8dece;
  border-radius: 28rpx;
  background: #fffdf8;
  box-shadow: 0 16rpx 44rpx rgba(52, 43, 29, 0.07);
}

.primary-button {
  min-height: 92rpx;
  border-radius: 24rpx;
  color: #fff;
  background: linear-gradient(135deg, #174f3b, #246449);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 92rpx;
}

.secondary-button {
  min-height: 88rpx;
  border: 1rpx solid #d8cdbd;
  border-radius: 22rpx;
  color: #174f3b;
  background: #fffdf8;
  font-size: 28rpx;
  line-height: 88rpx;
}

.muted {
  color: #7f817b;
  font-size: 24rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 38rpx 4rpx 18rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
}

.section-link {
  color: #6f756f;
  font-size: 24rpx;
}

.empty-state {
  padding: 52rpx 24rpx;
  color: #8a877f;
  text-align: center;
}

.bottom-nav {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  box-sizing: border-box;
  height: calc(112rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e8dece;
  padding: 12rpx 16rpx env(safe-area-inset-bottom);
  background: rgba(255, 253, 248, 0.97);
  box-shadow: 0 -10rpx 30rpx rgba(52, 43, 29, 0.05);
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #737873;
  font-size: 22rpx;
}

.nav-icon {
  margin-bottom: 4rpx;
  font-size: 34rpx;
  line-height: 1;
}

.nav-item.active {
  color: #174f3b;
  font-weight: 700;
}

.form-label {
  display: block;
  margin: 26rpx 0 12rpx;
  color: #334039;
  font-size: 26rpx;
  font-weight: 600;
}

.form-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  border: 1rpx solid #ddd3c4;
  border-radius: 20rpx;
  padding: 0 24rpx;
  background: #fff;
  font-size: 28rpx;
}
