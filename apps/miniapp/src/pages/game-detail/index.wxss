.detail-page { padding: 32rpx 32rpx calc(160rpx + env(safe-area-inset-bottom)); background: #fff; min-height: 80vh; color: #1b2420; }
.game-header { display: flex; gap: 24rpx; }
.cover { width: 260rpx; height: 360rpx; flex-shrink: 0; border-radius: 8rpx; }
.placeholder { display: flex; align-items: center; justify-content: center; background: #eee9df; color: #81877f; }
.game-summary { min-width: 0; flex: 1; }
.title-row { display: flex; align-items: center; justify-content: space-between; gap: 10rpx; margin: 20rpx 0 28rpx; }
.game-name { font-size: 36rpx; font-weight: 600; }
.heart { width: 40rpx; height: 40rpx; }
.pills { display: flex; flex-wrap: wrap; gap: 10rpx; }
.detail-categories { margin-top: 20rpx; }
.pills text { color: #174f3b; background: #e1f1eb; border-radius: 28rpx; padding: 8rpx 15rpx; font-size: 23rpx; }
.facts { display: flex; border-top: 1rpx solid #eee; margin-top: 32rpx; padding-top: 32rpx; }
.facts > view { flex: 1; min-width: 0; text-align: center; padding: 0 4rpx; border-right: 1rpx solid #eee; }
.facts > view:last-child { border: 0; }
.facts image { width: 38rpx; height: 38rpx; }
.facts text { display: block; font-size: 22rpx; margin-top: 10rpx; }
.muted { color: #81868c; font-size: 24rpx; }
.section { border-top: 1rpx solid #eee; margin-top: 38rpx; padding-top: 20rpx; }
.section-title { display: block; font-size: 30rpx; font-weight: 600; margin-bottom: 14rpx; }
.intro-copy { color: #656c74; font-size: 27rpx; line-height: 1.75; white-space: pre-wrap; }
.recommendation-note { margin-top: 34rpx; padding: 26rpx; border-radius: 16rpx; background: #faf7f1; color: #656c74; font-size: 26rpx; line-height: 1.8; }
.note-title { display: flex; align-items: center; gap: 16rpx; margin-bottom: 18rpx; color: #202922; font-weight: 600; font-size: 28rpx; }
.note-title image { width: 42rpx; height: 42rpx; }
.expansion-heading { display: flex; justify-content: space-between; align-items: center; }
.expansion-heading > text:last-child { font-size: 24rpx; }
.expansion { display: flex; gap: 20rpx; padding: 20rpx 0; border-bottom: 1rpx solid #eee; font-size: 26rpx; }
.expansion image { width: 110rpx; height: 130rpx; flex-shrink: 0; }
.expansion .expansion-cover-missing { display: flex; align-items: center; justify-content: center; width: 110rpx; height: 130rpx; flex: 0 0 110rpx; background: #eef1ea; font-size: 20rpx; color: #899185; }
.expansion > view { flex: 1; min-width: 0; }
.expansion-copy { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-top: 12rpx; }
.attribution { display: block; margin-top: 30rpx; color: #94998f; font-size: 20rpx; }
.actions { position: fixed; left: 0; right: 0; bottom: 0; display: flex; gap: 24rpx; padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); background: #fff; border-top: 1rpx solid #eee; }
.actions button { flex: 1; min-width: 0; margin: 0; padding: 0; border-radius: 14rpx; font-size: 27rpx; line-height: 90rpx; }
.record { border: 1rpx solid #174f3b; color: #174f3b; background: #fff; }
.meetup { color: #fff; background: #174f3b; }
