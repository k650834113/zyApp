.settings-page{padding-top:44rpx}.settings-card{border:1rpx solid #e2e5e1;border-radius:26rpx;background:#fff;padding:0 30rpx}.settings-card>view{display:flex;gap:28rpx;align-items:center;min-height:148rpx;border-bottom:1rpx solid #ececec;font-size:32rpx}.settings-card>view:last-child{border:0}.settings-card image{width:48rpx;height:48rpx}.arrow{margin-left:auto;font-size:42rpx;color:#858990}.version-row{display:flex;justify-content:space-between;gap:20rpx;border:1rpx solid #e2e5e1;border-radius:26rpx;padding:42rpx 34rpx;font-size:30rpx;color:#888;margin-top:30rpx}.logout{width:100%;border:2rpx solid #c64b4b;color:#bd3434;border-radius:60rpx;background:white;line-height:94rpx;font-size:30rpx;margin-top:66rpx}.document{background:#fff;border-radius:20rpx;padding:28rpx}.document-title{display:block;font-size:36rpx;font-weight:700}.document-version{display:block;font-size:23rpx;color:#888;margin:20rpx 0}.document-body{display:block;white-space:pre-wrap;line-height:1.8;font-size:28rpx}.document button{margin-top:30rpx;width:100%;font-size:28rpx}
.settings-page .logout{width:100%;box-sizing:border-box}
