.wheel-page { padding-bottom: 60rpx; }
.heading { display:block; font-size:38rpx; font-weight:700; color:#174f3b; margin:16rpx 0 10rpx; }
.hint { color:#7c857e; font-size:23rpx; }
.wheel-stage { width:300px; height:300px; margin:32rpx auto 20rpx; position:relative; }
.wheel-disc { width:300px; height:300px; border-radius:50%; overflow:hidden; }
.wheel-hub { position:absolute; top:125px; left:125px; width:50px; height:50px; line-height:50px; text-align:center; border-radius:50%; background:#fffdf9; color:#174f3b; box-shadow:0 2px 10px #0002; font-size:12px; pointer-events:none; }
.pointer { position:absolute; z-index:2; top:-6px; left:138px; width:0; height:0; border-left:12px solid transparent; border-right:12px solid transparent; border-top:30px solid #174f3b; }
.result { text-align:center; color:#174f3b; font-size:30rpx; font-weight:700; min-height:48rpx; overflow-wrap:anywhere; }
.spin-button { margin:18rpx 0 32rpx; color:#fff; background:#174f3b; border-radius:24rpx; font-weight:700; }
.editor { background:#fffdf9; padding:24rpx; border:1rpx solid #e5e8df; border-radius:26rpx; }
.editor-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:20rpx; font-weight:600; }
.item-row { display:flex; align-items:center; gap:12rpx; border:2rpx solid transparent; border-bottom-color:#eeeae2; padding:12rpx 8rpx; border-radius:12rpx; }
.item-row.selected { background:#fff0c7; border-color:#d18a16; }
.color-dot { width:18rpx; height:18rpx; border-radius:50%; flex-shrink:0; }
.name-input { flex:1; min-width:0; font-size:27rpx; height:64rpx; }
.count-input { width:66rpx; height:64rpx; text-align:center; background:#f4f3ed; border-radius:10rpx; font-size:27rpx; }
.remove { padding:0; margin:0; width:52rpx; line-height:60rpx; background:transparent; color:#99675d; font-size:34rpx; }
.remove::after { border:0; }
.add-button { margin-top:22rpx; color:#174f3b; background:#eaf3eb; border-radius:18rpx; font-size:27rpx; }
.error { display:block; color:#b44936; margin-top:18rpx; font-size:24rpx; }
