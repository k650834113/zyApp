<view class="invite-page"><text class="error" wx:if="{{error}}">{{error}}</text><button wx:if="{{error}}" bindtap="load">重试</button><block wx:if="{{member}}"><image src="{{member.avatarUrl || '/assets/icons/user-green.svg'}}"/><text class="invite-name">{{member.name}}</text><text>{{kind==='table'?'邀请你加入同桌':'邀请你添加好友'}}</text><text class="invite-note">{{kind==='table'?'确认后向发起者提供昵称和头像，由发起者计分；本局记录将自动加入你的对局记录。不自动添加好友。':'双方确认后成为好友，好友可将你加入共享对局，你可以隐藏自己不需要的记录。'}}</text><button bindtap="confirm" disabled="{{busy || done}}" loading="{{busy}}">{{done?(kind==='table'?'已加入，请由发起者统一计分':'好友申请已发送'):(kind==='table'?'确认加入同桌':'发送好友申请')}}</button></block></view>
