page {
  height: 100%;
  overflow: hidden;
  background: #0f2f25;
}

.first-page,
.touch-arena {
  min-height: 100vh;
}

.touch-arena {
  position: relative;
  box-sizing: border-box;
  overflow: hidden;
  padding: 70rpx 36rpx 260rpx;
  color: #fff;
  background:
    radial-gradient(circle at 50% 38%, rgba(87, 190, 143, 0.14), transparent 34%),
    #0f2f25;
}

.touch-layer {
  position: absolute;
  z-index: 1;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}

.arena-guide {
  position: absolute;
  z-index: 2;
  top: 31%;
  right: 40rpx;
  left: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  pointer-events: none;
}

.guide-ring {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 156rpx;
  height: 156rpx;
  border: 4rpx dashed rgba(213, 236, 224, 0.46);
  border-radius: 50%;
  color: #d8eee3;
  font-size: 54rpx;
  font-weight: 900;
}

.arena-status,
.arena-helper {
  display: block;
  text-align: center;
}

.arena-status {
  margin-top: 38rpx;
  font-size: 34rpx;
  font-weight: 800;
}

.arena-helper {
  margin-top: 15rpx;
  color: #a9cabb;
  font-size: 22rpx;
}

.finger-marker {
  position: fixed;
  z-index: 5;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 68px;
  height: 68px;
  border: 4px solid rgba(255, 255, 255, 0.86);
  border-radius: 50%;
  color: #0f2f25;
  background: #50d8ef;
  box-shadow: 0 0 0 10px rgba(80, 216, 239, 0.18), 0 10px 30px rgba(0, 0, 0, 0.28);
  font-size: 24px;
  font-weight: 900;
  transition: opacity 180ms ease, transform 180ms ease;
  transform: scale(0.78);
}

.finger-marker.lime { background: #d9ef52; box-shadow: 0 0 0 10px rgba(217,239,82,.18), 0 10px 30px rgba(0,0,0,.28); }
.finger-marker.amber { background: #ffb547; box-shadow: 0 0 0 10px rgba(255,181,71,.18), 0 10px 30px rgba(0,0,0,.28); }
.finger-marker.rose { background: #ff718d; box-shadow: 0 0 0 10px rgba(255,113,141,.18), 0 10px 30px rgba(0,0,0,.28); }
.finger-marker.violet { background: #ae8cff; box-shadow: 0 0 0 10px rgba(174,140,255,.18), 0 10px 30px rgba(0,0,0,.28); }
.finger-marker.blue { background: #6ca8ff; box-shadow: 0 0 0 10px rgba(108,168,255,.18), 0 10px 30px rgba(0,0,0,.28); }
.finger-marker.coral { background: #ff876b; box-shadow: 0 0 0 10px rgba(255,135,107,.18), 0 10px 30px rgba(0,0,0,.28); }
.finger-marker.mint { background: #60e2b3; box-shadow: 0 0 0 10px rgba(96,226,179,.18), 0 10px 30px rgba(0,0,0,.28); }
.finger-marker.gold { background: #f4d34f; box-shadow: 0 0 0 10px rgba(244,211,79,.18), 0 10px 30px rgba(0,0,0,.28); }
.finger-marker.sky { background: #75d1ff; box-shadow: 0 0 0 10px rgba(117,209,255,.18), 0 10px 30px rgba(0,0,0,.28); }
.finger-marker.pink { background: #f591d2; box-shadow: 0 0 0 10px rgba(245,145,210,.18), 0 10px 30px rgba(0,0,0,.28); }
.finger-marker.slate { background: #b4c5c1; box-shadow: 0 0 0 10px rgba(180,197,193,.18), 0 10px 30px rgba(0,0,0,.28); }

.has-result .finger-marker:not(.selected) {
  opacity: 0.18;
  transform: scale(0.64);
}

.finger-marker.selected {
  z-index: 7;
  color: #fff;
  background: #2fc68d;
  box-shadow: 0 0 0 16px rgba(47, 198, 141, 0.2), 0 0 44px rgba(47, 198, 141, 0.86);
  transform: scale(1.12);
}

.first-actions {
  position: fixed;
  z-index: 10;
  right: 28rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  left: 28rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.mode-button,
.add-player-button,
.draw-button {
  min-width: 0;
  flex: 1;
  margin: 0;
  border-radius: 24rpx;
  padding: 0 18rpx;
  font-size: 24rpx;
  font-weight: 750;
  line-height: 88rpx;
}

.mode-button {
  flex-basis: 100%;
  color: #d8eee3;
  background: rgba(255, 255, 255, 0.1);
}

.add-player-button {
  color: #d8eee3;
  background: rgba(255, 255, 255, 0.16);
}

.draw-button {
  color: #174f3b;
  background: #e4f455;
}

.draw-button[disabled] {
  color: #809187;
  background: #3b594c;
}
page,.touch-arena{background:#fbf7ef;color:#175540}.arena-guide{top:50rpx}.arena-title{font-size:44rpx;font-weight:700}.guide-ring{margin-top:110rpx;border-color:#c5d9c7;color:#498956}.arena-status{font-size:30rpx}.arena-helper{color:#828882;font-size:25rpx;line-height:1.6}.has-result .arena-status{position:fixed;left:36rpx;right:36rpx;bottom:260rpx;background:#edf0e5;padding:34rpx 20rpx;border-radius:20rpx;font-size:38rpx}.finger-marker{border:3px solid #ecffde;color:white;background:linear-gradient(140deg,#7bc976,#158d50);box-shadow:0 0 0 3px #aedc96,0 8px 20px #bed3b7;transform:scale(1.1)}.finger-marker.lime{background:linear-gradient(140deg,#ffe27d,#e4a723);box-shadow:0 0 0 3px #f7dc83,0 8px 20px #e1d7b9}.finger-marker.amber,.finger-marker.rose{background:linear-gradient(140deg,#ffa59b,#dc655a);box-shadow:0 0 0 3px #f4b4a0,0 8px 20px #dfc3b7}.has-result .finger-marker:not(.selected){opacity:1;transform:scale(1.05)}.finger-marker.selected{background:linear-gradient(140deg,#78d479,#0d8848);box-shadow:0 0 0 7px #b4e89b,0 0 30px #8bcb7e;transform:scale(1.25)}.first-actions .mode-button{color:#175540;background:transparent;border:1rpx solid #175540;font-size:24rpx;line-height:68rpx}.first-actions .draw-button{color:white;background:#175540;border-radius:60rpx}.first-actions .add-player-button{color:#175540;background:#eef2e9;border:1rpx solid #cbdaca}.draw-button[disabled]{opacity:.4}

.has-result .finger-marker:not(.selected){opacity:.12;filter:grayscale(1);transform:scale(.75)}
.has-result .finger-marker.selected{color:#fff;background:#101714;border:6px solid white;box-shadow:0 0 0 9px #101714;transform:scale(1.6)}
.has-result .arena-title,.has-result .arena-helper{color:#101714}.has-result .arena-status{color:#101714;background:rgba(255,255,255,.92)}
.locked .mode-button{background:#fff;color:#101714}.locked .draw-button{background:#101714;color:#fff}
