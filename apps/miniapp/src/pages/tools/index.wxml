<view class="page-shell tools-page">
  <view class="tool-grid">
    <view
      wx:for="{{tools}}"
      wx:key="path"
      class="tool-card {{item.tone}}"
      data-path="{{item.path}}"
      bindtap="openTool"
      hover-class="tool-card-pressed"
      hover-stay-time="80"
    >
      <view class="tool-icon">
        <view wx:if="{{item.glyph === 'wheel'}}" class="glyph glyph-wheel">✳</view>
        <view wx:if="{{item.glyph === 'first'}}" class="glyph glyph-first"><view></view><view></view><view></view></view>
        <view wx:if="{{item.glyph === 'teams'}}" class="glyph glyph-teams"><view></view><view></view><view></view><view></view></view>
        <view wx:if="{{item.glyph === 'dice'}}" class="glyph glyph-dice"><view></view><view></view><view></view><view></view><view></view></view>
        <view wx:if="{{item.glyph === 'coin'}}" class="glyph glyph-coin"><view></view></view>
        <view wx:if="{{item.glyph === 'score'}}" class="glyph glyph-score"><view></view><view></view><view></view></view>
      </view>
      <text class="tool-title">{{item.title}}</text>
    </view>
  </view>

  <ui-nav active="tools"/>
</view>
