.tools-page { padding-top: 24rpx; }
.tools-hero { position: relative; overflow: hidden; border-radius: 34rpx; padding: 42rpx 36rpx 46rpx; color: #fff; background: radial-gradient(circle at 86% 8%, rgba(255,255,255,.16), transparent 30%), linear-gradient(145deg, #103e30, #25674d); box-shadow: 0 18rpx 44rpx rgba(23,79,59,.2); }
.tools-eyebrow, .tools-title, .tools-subtitle, .tool-title { display: block; }
.tools-eyebrow { color: #c9e3d5; font-size: 21rpx; font-weight: 700; letter-spacing: 5rpx; }
.tools-title { max-width: 520rpx; margin-top: 14rpx; font-size: 44rpx; font-weight: 900; line-height: 1.28; }
.tools-subtitle { margin-top: 16rpx; color: #d9e8e0; font-size: 23rpx; line-height: 1.6; }
.hero-dots { position: absolute; right: 34rpx; bottom: 30rpx; display: flex; gap: 10rpx; }
.hero-dots text { width: 16rpx; height: 16rpx; border: 4rpx solid rgba(255,255,255,.7); border-radius: 50%; }
.tools-section-head { margin-top: 34rpx; }
.tool-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18rpx; }
.tool-card { display: flex; min-height: 224rpx; flex-direction: column; align-items: center; justify-content: center; border: 1rpx solid #e8e0d4; border-radius: 28rpx; background: #fffdf9; box-shadow: 0 10rpx 26rpx rgba(71,54,34,.07); transition: transform 80ms ease, opacity 80ms ease; }
.tool-card:last-child { grid-column: 1 / -1; min-height: 190rpx; }
.tool-card-pressed { opacity: .84; transform: scale(.98); }
.tool-icon { display: flex; width: 104rpx; height: 104rpx; align-items: center; justify-content: center; border-radius: 30rpx; color: #174f3b; background: #d8eee3; }
.tool-card.amber .tool-icon { color: #8b530b; background: #f6dfb6; }
.tool-card.blue .tool-icon { color: #285a73; background: #dbeaf2; }
.tool-card.gold .tool-icon { color: #8a6108; background: #f5e6a9; }
.tool-card.rose .tool-icon { color: #8b4a43; background: #f2dcd7; }
.tool-title { margin-top: 20rpx; color: #23332b; font-size: 28rpx; font-weight: 850; }
.glyph { position: relative; width: 68rpx; height: 68rpx; }
.glyph-first { border: 5rpx solid currentColor; border-radius: 50%; }
.glyph-first::before { position: absolute; top: 23rpx; left: 23rpx; width: 22rpx; height: 22rpx; border-radius: 50%; content: ''; background: currentColor; }
.glyph-first view { position: absolute; width: 13rpx; height: 13rpx; border-radius: 50%; background: currentColor; }
.glyph-first view:nth-child(1) { top: -7rpx; left: 27rpx; }.glyph-first view:nth-child(2) { right: -7rpx; bottom: 7rpx; }.glyph-first view:nth-child(3) { bottom: 2rpx; left: -5rpx; }
.glyph-teams view { position: absolute; width: 26rpx; height: 26rpx; border-radius: 50%; background: currentColor; }
.glyph-teams view:nth-child(1) { top: 2rpx; left: 8rpx; }.glyph-teams view:nth-child(2) { top: 2rpx; right: 0; opacity: .58; }.glyph-teams view:nth-child(3) { bottom: 3rpx; left: 8rpx; opacity: .58; }.glyph-teams view:nth-child(4) { right: 0; bottom: 3rpx; }
.glyph-dice { box-sizing: border-box; border: 5rpx solid currentColor; border-radius: 16rpx; transform: rotate(-7deg); }
.glyph-dice view { position: absolute; width: 12rpx; height: 12rpx; border-radius: 50%; background: currentColor; }
.glyph-dice view:nth-child(1) { top: 9rpx; left: 9rpx; }.glyph-dice view:nth-child(2) { top: 9rpx; right: 9rpx; }.glyph-dice view:nth-child(3) { top: 25rpx; left: 25rpx; }.glyph-dice view:nth-child(4) { right: 9rpx; bottom: 9rpx; }.glyph-dice view:nth-child(5) { bottom: 9rpx; left: 9rpx; }
.glyph-coin { box-sizing: border-box; border: 6rpx solid currentColor; border-radius: 50%; box-shadow: inset 0 0 0 5rpx rgba(255,255,255,.42); }
.glyph-coin::before { position: absolute; top: 13rpx; left: 13rpx; width: 30rpx; height: 30rpx; border: 4rpx dashed currentColor; border-radius: 50%; content: ''; }
.glyph-score { display: flex; align-items: flex-end; justify-content: center; gap: 8rpx; }
.glyph-score view { width: 15rpx; border-radius: 7rpx 7rpx 3rpx 3rpx; background: currentColor; }.glyph-score view:nth-child(1) { height: 34rpx; }.glyph-score view:nth-child(2) { height: 58rpx; }.glyph-score view:nth-child(3) { height: 45rpx; opacity: .65; }
.tool-free-note { margin-top: 28rpx; border: 1rpx solid #d9e9e0; border-radius: 22rpx; padding: 22rpx 24rpx; background: #f1f8f4; text-align: center; }
.tool-free-title, .tool-free-copy { display: block; }
.tool-free-title { color: #174f3b; font-size: 24rpx; font-weight: 800; }
.tool-free-copy { margin-top: 8rpx; color: #657069; font-size: 20rpx; line-height: 1.6; }
.privacy-note { margin-top: 28rpx; color: #91938e; font-size: 20rpx; text-align: center; }
.tools-page{padding-top:50rpx}.tool-grid{gap:28rpx}.tool-card{min-height:350rpx;background:linear-gradient(135deg,#eff6ee,#e9f3e6);border:1rpx solid #dce9df;border-radius:30rpx;box-shadow:none}.tool-card:last-child{min-height:290rpx}.tool-card .tool-icon{width:150rpx;height:150rpx;background:transparent;color:#10513f}.tool-title{font-size:38rpx;margin-top:28rpx}.glyph{transform:scale(1.65)}.glyph-dice{transform:scale(1.65) rotate(-7deg)}.glyph-coin:before{border-style:solid}.glyph-score{border:5rpx solid currentColor;border-radius:8rpx;height:70rpx;width:52rpx;align-items:center;flex-direction:column;gap:8rpx}.glyph-score view,.glyph-score view:nth-child(1),.glyph-score view:nth-child(2),.glyph-score view:nth-child(3){width:30rpx;height:5rpx;border-radius:4rpx;opacity:1}
.tools-page .tool-card .tool-icon{background:transparent;color:#10513f}.tools-page .tool-card{min-height:380rpx}.tools-page .tool-card:last-child{min-height:300rpx}.glyph-first{border:0;border-radius:0}.glyph-first:before{top:4rpx;left:25rpx;width:24rpx;height:24rpx}.glyph-first:after{content:"";position:absolute;top:32rpx;left:17rpx;width:40rpx;height:32rpx;border-radius:22rpx 22rpx 3rpx 3rpx;background:currentColor}.glyph-first view:nth-child(1){top:12rpx;left:1rpx;width:19rpx;height:19rpx}.glyph-first view:nth-child(2){top:12rpx;right:-5rpx;width:19rpx;height:19rpx}.glyph-first view:nth-child(3){bottom:4rpx;left:-4rpx;width:80rpx;height:28rpx;border-radius:24rpx 24rpx 3rpx 3rpx}.glyph-teams view:nth-child(1){top:4rpx;left:2rpx}.glyph-teams view:nth-child(2){top:4rpx;right:0;opacity:1}.glyph-teams view:nth-child(3){bottom:0;left:-3rpx;width:36rpx;height:30rpx;border-radius:20rpx 20rpx 3rpx 3rpx;opacity:1}.glyph-teams view:nth-child(4){bottom:0;right:-6rpx;width:36rpx;height:30rpx;border-radius:20rpx 20rpx 3rpx 3rpx}

.tool-card{border-color:#e5e8df;box-shadow:0 8rpx 24rpx rgba(29,64,46,.045)}.tool-icon{border-radius:28rpx}.tool-title{font-weight:700}

.glyph-wheel { font-size:72rpx; line-height:68rpx; text-align:center; }.tools-page .tool-card:last-child { grid-column:auto; min-height:380rpx; }
