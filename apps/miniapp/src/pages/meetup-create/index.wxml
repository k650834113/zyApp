<view class="community-page">
<view wx:if="{{loading}}" class="unavailable">正在加载…</view>
<view wx:if="{{error}}" class="error">{{error}}<button bindtap="refresh" disabled="{{busy}}">重试加载</button></view>
<view wx:if="{{!demo && !ready}}" class="unavailable">请先登录后使用此功能。</view>
<block wx:else>
<view id="field-gameId" class="game-search"><text class="form-label">选择桌游 *</text><input value="{{gameQuery}}" bindinput="inputGameQuery" placeholder="输入桌游名称搜索"/><text wx:if="{{game}}">已选择：{{game.name}}</text><text wx:if="{{gameSearching}}">正在搜索…</text><scroll-view scroll-y class="game-search-results" wx:if="{{gameQuery && !game}}"><view wx:for="{{games}}" wx:key="id" data-id="{{item.id}}" bindtap="selectGame" class="form-row">{{item.name}}</view><text wx:if="{{!gameSearching && !games.length && !game}}">没有匹配桌游，请换个关键词</text></scroll-view><text class="field-error">{{fieldErrors.gameId}}</text></view>
<view class="form-row"><text class="form-label">约局标题 <text class="required">*</text></text><view class="form-value"><input id="field-title" class="{{fieldErrors.title?'field-invalid':''}}" maxlength="40" value="{{title}}" bindinput="inputTitle" placeholder="请输入标题"/><text class="field-error">{{fieldErrors.title}}</text></view></view>
<view class="form-row"><text class="form-label">日期 <text class="required">*</text></text><picker id="field-date" mode="date" value="{{date}}" bindchange="chooseDate"><view class="{{fieldErrors.date?'field-invalid':''}} form-value">{{date || '选择日期'}} ›</view></picker><text class="field-error">{{fieldErrors.date}}</text></view>
<view class="form-row"><text class="form-label">开始时间 <text class="required">*</text></text><picker id="field-time" mode="time" value="{{time}}" bindchange="chooseTime"><view class="{{fieldErrors.time?'field-invalid':''}} form-value">{{time}} ›</view></picker><text class="field-error">{{fieldErrors.time}}</text></view>
<view class="form-row"><text class="form-label">预计时长（分钟）</text><view class="form-value"><input id="field-duration" class="{{fieldErrors.duration?'field-invalid':''}}" type="number" value="{{duration}}" bindinput="inputDuration"/><text class="field-error">{{fieldErrors.duration}}</text></view></view>
<view class="form-row"><text class="form-label">总人数（含发起人）</text><view class="form-value"><input id="field-capacity" class="{{fieldErrors.capacity?'field-invalid':''}}" type="number" value="{{capacity}}" bindinput="inputCapacity"/><text class="field-error">{{fieldErrors.capacity}}</text></view></view>
<view class="form-row"><text class="form-label">报名截止 <text class="required">*</text></text><view class="form-value"><view id="field-deadline"><picker mode="date" value="{{deadlineDate}}" end="{{date}}" bindchange="chooseDeadlineDate"><view>{{deadlineDate}} ›</view></picker><picker mode="time" value="{{deadlineTime}}" bindchange="chooseDeadlineTime"><view>{{deadlineTime}} ›</view></picker></view><text class="field-error">{{fieldErrors.deadline}}</text></view></view>
<view class="form-row"><view style="flex:1"><text>新手友好</text><text class="form-note">开启后会在列表中显示新手友好标签</text></view><switch checked="{{friendly}}" color="#175540" bindchange="toggleFriendly"/></view>
<text class="section-title">约局说明 <text class="required">*</text></text><textarea id="field-description" class="{{fieldErrors.description?'field-invalid':''}} textarea" value="{{description}}" maxlength="200" bindinput="inputDescription" placeholder="一起玩什么，有什么要求…"/><text class="field-error">{{fieldErrors.description}}</text>
<view class="form-row" style="margin-top:28rpx"><text class="form-label">地点</text><text class="form-value">{{location}}</text></view>
<text class="error">{{error}}</text><button class="solid" loading="{{busy}}" bindtap="publish">发布约局</button><text wx:if="{{demo}}" class="demo-note">开发演示，发布仅保留在本次演示会话</text>
</block>
</view>
