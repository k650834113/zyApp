<view class="page-shell workspace-page"><text class="heading">活动报名</text><text wx:if="{{loading}}" class="muted">正在读取报名信息…</text><text wx:if="{{error}}" class="error">{{error}}</text><button wx:if="{{error}}" bindtap="load">重新读取</button>
<view wx:if="{{admission}}" class="card"><text class="section-title">{{admission.title}}</text><text class="muted">预计开奖时间：{{drawTime}}</text><text class="notice-body">{{admission.rules}}</text>
<block wx:if="{{admission.result}}"><text class="section-title">{{resultText}}</text><text class="muted">中奖者请联系门店核验身份及领取方式。</text></block>
<block wx:elif="{{admission.registered}}"><text class="section-title">报名成功</text><text class="muted">每位会员限报名一次，已取得本次抽奖资格。</text><notice-subscribe wx:if="{{member}}" scene="lottery.result" business-id="{{admission.activityId}}" label="开启开奖结果微信提醒" bindcomplete="subscribed"/><text wx:if="{{subscriptionResult}}" class="muted">{{subscriptionResult === 'accept' ? '已申请微信提醒' : '未开启微信提醒，可回到小程序查看结果'}}</text><button class="secondary" bindtap="messages">消息中心</button></block>
<block wx:elif="{{member}}"><notice-subscribe scene="lottery.result" business-id="{{admission.activityId}}" label="确认报名并开启开奖提醒" disabled="{{busy}}" bindcomplete="confirm"/><button class="secondary" disabled="{{busy}}" bindtap="confirm">仅确认报名</button><text class="muted">拒绝订阅不影响报名。报名后可在消息中心查看结果。</text></block>
<block wx:else><text class="muted">请先注册或登录会员，再确认报名。名额从扫码起预留10分钟，超过活动报名截止时间则失效。</text><button bindtap="login">注册 / 登录后继续报名</button></block></view><button wx:if="{{!admission && error}}" class="secondary" bindtap="login">登录后继续</button></view>
