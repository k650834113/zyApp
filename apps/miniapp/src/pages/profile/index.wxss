.profile-page {
  padding-top: 20rpx;
}

.profile-page.complete-mode {
  padding-bottom: 50rpx;
}

.profile-heading {
  text-align: center;
}

.heading-title,
.heading-subtitle,
.count-text,
.privacy-tip {
  display: block;
}

.heading-title {
  font-size: 38rpx;
  font-weight: 750;
}

.heading-subtitle {
  margin-top: 14rpx;
  color: #92918a;
  font-size: 23rpx;
}

.avatar-section {
  margin-top: 46rpx;
  text-align: center;
}

.profile-page:not(.complete-mode) .avatar-section {
  margin-top: 12rpx;
}

.avatar-picker-button {
  position: relative;
  width: 188rpx;
  height: 188rpx;
  margin: 0 auto;
  padding: 0;
  border: 1rpx solid #e4d9c9;
  border-radius: 50%;
  color: inherit;
  background: #fffdf8;
  line-height: normal;
  overflow: visible;
}

.avatar-picker-button::after {
  border: 0;
}

.profile-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 188rpx;
  height: 188rpx;
  border: 8rpx solid #fff;
  border-radius: 50%;
  background: #e8e0d4;
}

.avatar-fallback {
  color: #174f3b;
  font-size: 66rpx;
  font-weight: 800;
}

.camera-badge {
  position: absolute;
  right: -2rpx;
  bottom: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border: 5rpx solid #fffdf8;
  border-radius: 50%;
  color: #fff;
  background: #174f3b;
  font-size: 25rpx;
}

.profile-form {
  position: relative;
  margin-top: 48rpx;
}

.nickname-input {
  padding-right: 92rpx;
}

.count-text {
  position: absolute;
  right: 22rpx;
  top: 84rpx;
  color: #99978f;
  font-size: 22rpx;
}

.account-card {
  margin-top: 34rpx;
  padding: 8rpx 28rpx;
}

.account-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  border-bottom: 1rpx solid #eee5d9;
}

.account-row:last-child {
  border-bottom: 0;
}

.account-label {
  color: #6f746f;
  font-size: 25rpx;
}

.account-value {
  color: #28352f;
  font-size: 25rpx;
  font-weight: 600;
}

.favorites-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 28rpx;
}

.favorites-title,
.favorites-subtitle,
.guest-title,
.guest-subtitle {
  display: block;
}

.favorites-title,
.guest-title {
  color: #28352f;
  font-size: 28rpx;
  font-weight: 700;
}

.favorites-subtitle,
.guest-subtitle {
  margin-top: 8rpx;
  color: #888a85;
  font-size: 23rpx;
}

.entry-arrow {
  color: #a29c91;
  font-size: 36rpx;
}

.guest-profile {
  padding-top: 36rpx;
}

.guest-card {
  padding: 34rpx 28rpx;
}

.guest-card .secondary-button {
  margin-top: 28rpx;
}

.save-button {
  margin-top: 42rpx;
  box-shadow: 0 14rpx 28rpx rgba(23, 79, 59, 0.18);
}

.privacy-tip {
  margin-top: 30rpx;
  color: #888a85;
  text-align: center;
  font-size: 21rpx;
  line-height: 1.7;
}
