.compact {
  padding: 28rpx;
}

.block {
  display: block;
  margin-top: 12rpx;
}

.card {
  margin-top: 22rpx;
}

.capability-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 24rpx;
}

.capability {
  border-radius: 14rpx;
  padding: 20rpx 12rpx;
  color: #405649;
  background: #edf1ed;
  font-size: 24rpx;
  font-weight: 800;
  text-align: center;
}

.capability.pending {
  color: #817462;
  background: #f2ece2;
}

.identity-card,
.detail-heading,
.inline-form,
.member-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.compact-button {
  width: auto;
  min-width: 126rpx;
  margin: 0;
  padding: 0 22rpx;
}

.inline-form {
  align-items: flex-end;
  margin-top: 16rpx;
}

.inline-form .form-input {
  flex: 1;
  margin-top: 0;
}

.member-row {
  margin-top: 16rpx;
  border: 1rpx solid #e1d7c8;
  border-radius: 16rpx;
  padding: 20rpx;
  background: #fff;
}

.member-row.selected {
  border-color: #587162;
  background: #edf1ed;
}

.member-name,
.detail-value {
  display: block;
  font-weight: 800;
}

.member-balance {
  flex: none;
  color: #3f5a4b;
  font-size: 28rpx;
  font-weight: 800;
}

.detail-heading {
  align-items: flex-start;
}

.detail-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-top: 24rpx;
  border-top: 1rpx solid #e5dccf;
  padding-top: 22rpx;
}

.detail-label {
  display: block;
  margin-bottom: 6rpx;
  color: #817462;
  font-size: 22rpx;
}

.small-empty {
  padding: 34rpx 10rpx;
}

.finance-form,
.monthly-panel {
  margin-top: 22rpx;
  border-top: 1rpx solid #e5dccf;
  padding-top: 22rpx;
}

.section-label {
  display: block;
  color: #3f5a4b;
  font-size: 28rpx;
  font-weight: 800;
}

.mini-button {
  width: auto;
  min-width: 104rpx;
  margin: 0;
  padding: 0 18rpx;
  font-size: 23rpx;
  line-height: 2.3;
}

.catalog-grid,
.cart-list {
  margin-top: 22rpx;
}

.catalog-item,
.cart-line,
.payment-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.catalog-item {
  margin-top: 12rpx;
  border: 1rpx solid #e1d7c8;
  border-radius: 16rpx;
  padding: 18rpx;
  background: #fff;
}

.custom-form {
  display: grid;
  grid-template-columns: 1.4fr 0.8fr;
  gap: 12rpx;
  margin-top: 22rpx;
}

.custom-form .form-input,
.custom-form .secondary-button {
  margin-top: 0;
}

.custom-form .secondary-button {
  grid-column: 1 / -1;
}

.cart-line {
  align-items: flex-start;
  border-top: 1rpx solid #e5dccf;
  padding: 20rpx 0;
}

.cart-main {
  flex: 1;
}

.quantity {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.quantity-button {
  width: 58rpx;
  min-width: 58rpx;
  margin: 0;
  padding: 0;
  border-radius: 12rpx;
  color: #3f5a4b;
  background: #ebe4d8;
  line-height: 2;
}

.benefit-button {
  width: auto;
  margin: 12rpx 0 0;
  padding: 0 16rpx;
  border-radius: 999rpx;
  color: #6f624f;
  background: #eee7dc;
  font-size: 21rpx;
  line-height: 2.2;
}

.benefit-button.active,
.payment-button.active {
  color: #fff;
  background: #3f5a4b;
}

.payment-row {
  margin-top: 20rpx;
}

.payment-button {
  flex: 1;
  margin: 0;
  border-radius: 14rpx;
  color: #3f5a4b;
  background: #ebe4d8;
  font-size: 25rpx;
}

.command-status {
  margin-top: 20rpx;
  border-radius: 16rpx;
  padding: 20rpx;
  background: #f2ece2;
}

.command-status.completed {
  background: #e5f3e8;
}

.command-status.failed,
.command-status.expired {
  background: #f8e3df;
}
