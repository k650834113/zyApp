.login-page{padding:28rpx 40rpx 50rpx;color:#18212a}.login-art{display:block;width:560rpx;height:480rpx;margin:0 auto 28rpx}.login-title{display:block;text-align:center;font-size:48rpx;font-weight:700}.login-subtitle{display:block;text-align:center;font-size:28rpx;color:#666;margin:20rpx 0 60rpx}.login-button{font-size:32rpx;line-height:100rpx}.terms{font-size:24rpx;line-height:40rpx;margin:32rpx 0;text-align:center;color:#666}.terms text:last-child{color:#175540}.divider{text-align:center;color:#888;font-size:24rpx;margin:36rpx 0}.browse-button{background:transparent;color:#175540;border:2rpx solid #175540;line-height:84rpx;font-size:30rpx}.login-note{display:block;color:#777;font-size:24rpx;text-align:center;margin-top:52rpx}.fallback-card{background:#fff;padding:24rpx;border-radius:16rpx;font-size:26rpx}.code-row{display:flex;gap:12rpx;align-items:center}.code-row input{flex:1;min-width:0}.code-row button{font-size:24rpx;padding:0 16rpx}.login-hint{display:block;font-size:24rpx;color:#777;margin:12rpx 0}.form-input{margin:16rpx 0}
.login-page button{width:100%;box-sizing:border-box;border-radius:12rpx}.fallback-toggle{display:block;text-align:center;color:#175540;font-size:24rpx;margin:20rpx 0}.code-row button{width:230rpx;flex-shrink:0}.login-art{height:450rpx}.login-subtitle{margin-bottom:44rpx}.login-title{font-size:44rpx}.divider{margin:24rpx 0}
.login-page .login-art{width:650rpx;max-width:100%;height:520rpx}.terms{display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:6rpx}.agreement-box{width:32rpx;height:32rpx;border:2rpx solid #aeb8b2;border-radius:6rpx;line-height:32rpx;flex-shrink:0;margin-right:8rpx}.agreement-box.checked{background:#175540;color:white;border-color:#175540}.divider{display:flex;align-items:center;gap:25rpx}.divider::before,.divider::after{content:'';height:1rpx;flex:1;background:#e6e3dc}

.login-art{border-radius:28rpx}.login-title{letter-spacing:1rpx}.fallback-card{border:1rpx solid #e5e8df;border-radius:26rpx;background:#fffdf8}.login-subtitle{line-height:1.7}

.login-brand{display:flex;align-items:center;justify-content:center;width:240rpx;height:138rpx;margin:0 auto 24rpx;border-radius:28rpx;background:#174f3b}.login-logo{display:block;width:190rpx;height:106rpx}
