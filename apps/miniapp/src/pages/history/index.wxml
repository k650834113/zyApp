<view class="page-shell history-page">
  <view class="filter-row">
    <view class="filter-pill {{filter === 'all' ? 'active' : ''}}" data-filter="all" bindtap="chooseFilter">全部</view>
    <view class="filter-pill {{filter === 'consumption' ? 'active' : ''}}" data-filter="consumption" bindtap="chooseFilter">消费</view>
    <view class="filter-pill {{filter === 'recharge' ? 'active' : ''}}" data-filter="recharge" bindtap="chooseFilter">预存款</view>
    <view class="filter-pill {{filter === 'monthly_card' ? 'active' : ''}}" data-filter="monthly_card" bindtap="chooseFilter">月卡</view>
  </view>

  <block wx:if="{{loading}}">
    <view class="empty-state">正在加载明细…</view>
  </block>
  <block wx:elif="{{groups.length === 0}}">
    <view class="card empty-state">暂无相关明细</view>
  </block>
  <block wx:else>
    <view wx:for="{{groups}}" wx:key="date" class="date-group">
      <text class="date-title">{{item.date}}</text>
      <view class="card group-card">
        <view wx:for="{{item.items}}" wx:for-item="activity" wx:key="activityId" class="activity-row">
          <view class="activity-icon {{activity.kind}}"><image src="/assets/icons/receipt-green.svg"/></view>
          <view class="activity-main">
            <text class="activity-title">{{activity.kind === 'recharge' ? '门店预存款充值' : activity.title}}</text>
            <text class="activity-meta">
              {{activity.timeText}}{{activity.businessNumber ? '　单号：' + activity.businessNumber : ''}}
            </text>
          </view>
          <view class="activity-right">
            <text class="activity-amount {{activity.amountClass}}">{{activity.amountText}}</text>
            <text class="activity-status">{{activity.statusText}}</text>
          </view>
        </view>
      </view>
    </view>
  </block>

  <view class="safe-tip">消费记录仅展示门票金额，饮品等商品不在此列。预存款与月卡仅用于门店线下服务。</view>

</view>
