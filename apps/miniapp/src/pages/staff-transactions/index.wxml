<view class="page-shell workspace-page"><text class="heading">近期交易</text><text class="muted">当前门店已同步到云端的交易，默认近30天。</text>
<block wx:if="{{!selected}}"><view class="card"><view class="filter-row"><picker mode="date" value="{{fromDate}}" bindchange="dateFrom"><view class="picker">{{fromDate}}</view></picker><picker mode="date" value="{{toDate}}" bindchange="dateTo"><view class="picker">{{toDate}}</view></picker></view><picker range="{{kinds}}" value="{{kindIndex}}" bindchange="kind"><view class="picker">{{kinds[kindIndex]}} ›</view></picker><input placeholder="会员名 / 手机号 / 会员编号" value="{{query}}" bindinput="input" bindconfirm="search"/><button bindtap="search" loading="{{busy}}">查询</button></view>
<text wx:if="{{error}}" class="error">{{error}}</text><view wx:for="{{items}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="detail"><text class="section-title">{{item.memberName}} · {{item.statusText}}</text><text>{{item.title}}</text><text class="amount">{{item.amountText}}</text><text wx:if="{{item.giftFen}}" class="muted">{{item.kind === 'refund' ? '收回赠送' : '赠送'}} {{item.giftText}}</text><text class="muted">{{item.timeText}} ›</text></view><text wx:if="{{!busy && !items.length && !error}}" class="muted">此范围暂无交易记录。</text><button wx:if="{{hasMore}}" bindtap="more" loading="{{busy}}" disabled="{{busy}}">加载更多</button></block>
<view wx:else class="card"><text class="section-title">{{selected.memberName}} · {{selected.memberNumber || '散客'}}</text><text class="notice-body">{{selected.title}}</text><text class="amount">{{selected.amountText}}</text><text wx:if="{{selected.giftFen}}">{{selected.kind === 'refund' ? '收回赠送' : '赠送'}}：{{selected.giftText}}</text><text class="muted">{{selected.timeText}} · {{selected.statusText}}</text><text class="muted">业务编号：{{selected.businessNumber || selected.id}}</text><text class="notice-body">{{selected.details}}</text><button bindtap="close">返回列表</button></view></view>
