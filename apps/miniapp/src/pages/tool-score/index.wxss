.score-page .finish-game{position:fixed;bottom:calc(28rpx + env(safe-area-inset-bottom));left:28rpx;width:calc(100% - 56rpx);box-sizing:border-box;color:white;background:#175540;line-height:96rpx;border-radius:60rpx;font-size:32rpx}

.score-head .reset{border:2rpx solid #a74e3f;color:#923d30;background:#fff0ec;border-radius:16rpx;padding:10rpx 24rpx;font-size:27rpx;font-weight:700;line-height:54rpx}

.social-actions{display:flex;flex-wrap:wrap;gap:14rpx;padding:28rpx}.social-actions button{font-size:25rpx;color:#175540;background:#e8f2e5}.social-error{display:block;color:#a43b32;padding:0 28rpx}.table-code,.table-members{padding:24rpx;margin:20rpx 28rpx;background:white;border-radius:20rpx;text-align:center}.table-code image{display:block;width:430rpx;height:430rpx;margin:auto}.table-code text{font-size:24rpx}.table-members>view{display:flex;align-items:center;justify-content:space-between}.table-members button{font-size:24rpx;color:#175540}
