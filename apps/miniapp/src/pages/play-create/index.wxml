<view class="community-page">
<view wx:if="{{loading}}" class="unavailable">正在加载…</view>
<view wx:if="{{error}}" class="error">{{error}}</view>
<view wx:if="{{!demo && !ready}}" class="unavailable">请先登录后使用此功能。</view>
<block wx:else>
<view class="form-row"><input value="{{gameQuery}}" bindinput="inputGameQuery" placeholder="搜索全部桌游"/><button bindtap="searchGames">搜索</button></view>
<text class="section-title">选择游戏 <text class="required">*</text></text><picker id="field-gameId" class="{{fieldErrors.gameId?'field-invalid':''}}" range="{{games}}" range-key="name" value="{{gameIndex}}" bindchange="chooseGame"><view class="form-value picker-value"><image wx:if="{{game.imageUrl}}" src="{{game.imageUrl}}" mode="aspectFit"/><text>{{game.name || '选择游戏'}}</text><text>›</text></view></picker><text class="field-error">{{fieldErrors.gameId}}</text>
<view class="date-columns"><view id="field-date" class="{{fieldErrors.date?'field-invalid':''}}"><text class="form-label">对局日期</text><picker mode="date" value="{{date}}" bindchange="chooseDate"><view class="form-value">{{date}}</view></picker><text class="field-error">{{fieldErrors.date}}</text></view><view id="field-duration" class="{{fieldErrors.duration?'field-invalid':''}}"><text class="form-label">时长（分钟）</text><view class="form-value"><input type="number" value="{{duration}}" bindinput="inputDuration"/></view><text class="field-error">{{fieldErrors.duration}}</text></view></view>
<text id="field-mode" class="section-title">对局模式</text><view class="mode-options"><view wx:for="{{modes}}" wx:key="*this" class="{{mode===item?'active':''}}" data-mode="{{item}}" bindtap="setMode">{{item}}</view></view>
<view class="form-row"><text>记录分数</text><switch checked="{{recordScores}}" color="#175540" bindchange="toggleScores"/></view>
<view wx:if="{{mode!=='合作'}}" id="field-resultType" class="{{fieldErrors.resultType?'field-invalid':''}}"><text class="section-title">结果形式</text><view class="mode-options"><view class="{{resultType==='single'?'active':''}}" data-type="single" bindtap="setResultType">单人胜利</view><view class="{{resultType==='multiple'?'active':''}}" data-type="multiple" bindtap="setResultType">多人胜利</view><view class="{{resultType==='ranking'?'active':''}}" data-type="ranking" bindtap="setResultType">排名</view></view><text wx:if="{{mode==='团队'}}" class="form-note">按队伍判定胜负与名次</text><text class="field-error">{{fieldErrors.resultType}}</text></view>
<text id="field-players" class="section-title">玩家成绩</text>
<scroll-view scroll-x scroll-into-view="{{errorAnchor}}" scroll-with-animation class="play-table-scroll"><view class="play-results-table">
<view class="play-results-row play-results-head"><view>玩家</view><view wx:if="{{mode==='团队'}}">队伍</view><view wx:if="{{recordScores}}">得分</view><view>{{mode==='合作'?'共同结果':resultType==='ranking'?'名次':'结果'}}</view><view class="remove-cell">操作</view></view>
<view wx:for="{{players}}" wx:key="index" class="play-results-row">
<view id="field-players-{{index}}-name" class="{{playerErrors[index].name?'field-invalid':''}}"><image wx:if="{{item.avatarUrl}}" class="player-avatar" src="{{item.avatarUrl}}"/><input value="{{item.name}}" disabled="{{!!item.memberId}}" placeholder="玩家姓名" data-index="{{index}}" data-field="name" bindinput="inputPlayer" maxlength="{{item.memberId?40:12}}"/><text class="field-error">{{playerErrors[index].name}}</text></view>
<view wx:if="{{mode==='团队'}}" id="field-players-{{index}}-team" class="{{playerErrors[index].team?'field-invalid':''}}"><input value="{{item.team}}" placeholder="队伍名称" data-index="{{index}}" data-field="team" bindinput="inputPlayer" maxlength="12"/><text class="field-error">{{playerErrors[index].team}}</text></view>
<view wx:if="{{recordScores}}" id="field-players-{{index}}-score" class="{{playerErrors[index].score?'field-invalid':''}}"><input wx:if="{{mode!=='合作' || index===0}}" value="{{item.score}}" placeholder="得分" data-index="{{index}}" data-field="score" bindinput="inputPlayer"/><text wx:else>{{item.score || '—'}}（共享）</text><text class="field-error">{{playerErrors[index].score}}</text></view>
<view wx:if="{{mode==='合作'}}" id="{{index===0?'field-result':''}}" class="{{fieldErrors.result?'field-invalid':''}}"><picker wx:if="{{index===0}}" range="{{resultLabels}}" value="{{result==='win'?0:result==='loss'?1:2}}" bindchange="chooseResult"><view>{{result==='win'?'胜利':result==='loss'?'失败':'平局'}} ▾</view></picker><text wx:else>{{result==='win'?'胜利':result==='loss'?'失败':'平局'}}（共享）</text><text wx:if="{{index===0}}" class="field-error">{{fieldErrors.result}}</text></view>
<view wx:elif="{{resultType==='ranking'}}" id="field-players-{{index}}-rank" class="{{playerErrors[index].rank?'field-invalid':''}}"><input wx:if="{{manualRank || !recordScores}}" type="number" value="{{item.rank || ''}}" placeholder="名次" data-index="{{index}}" data-field="rank" bindinput="inputPlayer"/><text wx:else>{{item.rank || '—'}}</text><text class="field-error">{{playerErrors[index].rank}}</text></view>
<view wx:else id="field-players-{{index}}-outcome" class="{{playerErrors[index].outcome?'field-invalid':''}}"><picker range="{{resultLabels}}" value="{{item.outcome==='win'?0:item.outcome==='loss'?1:2}}" data-index="{{index}}" bindchange="chooseOutcome"><view>{{item.outcome==='win'?'胜利':item.outcome==='draw'?'平局':'失败'}} ▾</view></picker><text class="field-error">{{playerErrors[index].outcome}}</text></view>
<view class="remove-cell"><button data-index="{{index}}" bindtap="removePlayer" disabled="{{players.length<=1}}">×</button></view>
</view></view></scroll-view>
<text wx:if="{{mode==='合作'}}" class="form-note">首行设置全员共享成绩与结果</text><text wx:if="{{mode==='团队'}}" class="form-note">填写相同队伍名称即为同队，修改成绩同步到同队成员</text>
<view class="player-add-actions"><button class="outline" bindtap="addPlayer" disabled="{{players.length>=8}}">＋ 临时玩家</button><button class="outline" bindtap="addFriend" disabled="{{players.length>=8 || busy}}">从好友添加</button></view>
<view wx:if="{{mode!=='合作' && resultType==='ranking' && recordScores}}" class="form-row"><text class="form-label">名次排序规则</text><view class="form-value" bindtap="toggleRank">{{ascending?'得分低者优先':'得分高者优先'}}　⌄</view><button bindtap="toggleManual">{{manualRank?'切换自动排名':'手动排名'}}</button></view>
<button wx:if="{{mode!=='合作' && resultType!=='ranking'}}" class="outline" bindtap="setAllDraw">全员平局</button>
<text class="section-title">本局备注（选填）</text><textarea id="field-note" class="textarea {{fieldErrors.note?'field-invalid':''}}" value="{{note}}" bindinput="inputNote" maxlength="200" placeholder="记录一些有趣的瞬间…"/><text class="field-error">{{fieldErrors.note}}</text>
<view class="form-row"><text class="form-label">可见范围</text><text class="form-value">仅创建者与关联参与者</text></view><text class="form-note">关联好友或同桌会员会自动收到本局记录；手填玩家不关联账号。</text>
<button class="solid" loading="{{busy}}" disabled="{{busy}}" bindtap="savePlay">保存对局</button><text wx:if="{{demo}}" class="demo-note">开发演示，保存仅保留在本次演示会话</text>
</block></view>
