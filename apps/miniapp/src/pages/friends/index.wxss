page{background:#fbf7ef}.friends-page{padding:32rpx}.friend-actions,.friend-search{display:flex;gap:16rpx;margin-bottom:24rpx}.friend-actions button,.friend-search button,.friend-row button{font-size:25rpx;color:#175540;background:#e7f1e7;margin:0;padding:0 20rpx}.friend-search input{flex:1;min-width:0;background:white;padding:20rpx;border-radius:16rpx}.friend-row{display:flex;align-items:center;gap:16rpx;background:white;padding:24rpx;border-radius:18rpx;margin:16rpx 0}.friend-row image{width:72rpx;height:72rpx;border-radius:50%;flex-shrink:0}.friend-row>view{flex:1;min-width:0}.friend-row text{display:block}.muted{font-size:23rpx;color:#7c887f;margin-top:8rpx}.section-title{display:block;font-weight:700;font-size:30rpx;margin:32rpx 0 20rpx}.error{display:block;color:#ab342c}.code-panel{background:white;padding:28rpx;margin-top:28rpx;text-align:center;border-radius:20rpx}.code-panel image{display:block;width:430rpx;height:430rpx;margin:20rpx auto}
.friends-header{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-bottom:24rpx}.friends-header>.muted{flex:1;min-width:0;margin:0}.friends-header .friend-actions{flex-shrink:0;margin:0;gap:12rpx}.friend-actions .icon-button{display:flex;align-items:center;justify-content:center;width:76rpx;height:76rpx;padding:0;border-radius:18rpx;background:transparent}.icon-button image{width:44rpx;height:44rpx}.icon-button::after{border:0}.icon-button[disabled]{opacity:.4}
.friend-search button { display:flex; align-items:center; justify-content:center; flex:0 0 auto; width:auto; min-width:0; padding:0 24rpx; line-height:1; }
