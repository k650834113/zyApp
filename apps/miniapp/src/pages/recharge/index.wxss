@import "../member/index.wxss";
.recharge-page{padding-bottom:60rpx}.current-balance{position:relative;padding:28rpx;background:white;border:1rpx solid #e4e5e3;border-radius:16rpx;font-size:26rpx;color:#777}.current-amount{display:block;color:#174f3b;font-size:58rpx;font-weight:700;margin-top:16rpx}.current-balance>text:last-child{position:absolute;right:28rpx;bottom:35rpx;font-size:23rpx}.recharge-card{box-shadow:none;border:0;background:transparent;padding:0;margin-top:34rpx}.recharge-title{font-size:34rpx;color:#172029}.recharge-subtitle,.recharge-scope-note{display:none}.recharge-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx;margin-top:24rpx}.recharge-option{width:100%;min-height:170rpx;background:#fff;border:2rpx solid #e0e4e1;border-radius:14rpx;color:#172029}.recharge-option.selected{background:#edf5ee;border-color:#175540;color:#175540}.recharge-option-amount{font-size:34rpx}.recharge-gift-estimate{font-size:26rpx}.recharge-total-estimate{font-size:23rpx}.custom-recharge{background:white;border:1rpx solid #e4e5e3;border-radius:14rpx;margin-top:22rpx}.recharge-button{width:100%;border-radius:14rpx;margin-top:40rpx}.recharge-result{padding:24rpx;box-shadow:none}
.recharge-page .recharge-options{gap:16rpx}.recharge-page .recharge-option{margin:0;min-width:0;padding:20rpx 6rpx;box-sizing:border-box}.recharge-page .recharge-option.selected .recharge-gift-estimate,.recharge-page .recharge-option.selected .recharge-total-estimate{color:#175540}.recharge-page .recharge-gift-estimate{color:#175540}.recharge-page .recharge-button{width:100%;max-width:none;box-sizing:border-box}.recharge-breakdown{background:#fff;padding:28rpx;border:1rpx solid #e4e5e3;border-radius:14rpx;margin-top:28rpx;font-size:28rpx}.breakdown-title{font-weight:700;display:block;margin-bottom:22rpx}.recharge-breakdown>view{display:flex;justify-content:space-between;margin:18rpx 0}.breakdown-total{border-top:1rpx solid #ddd;padding-top:22rpx;font-weight:700}.breakdown-total text:last-child{color:#175540}.recharge-page .recharge-rule-note{margin-top:26rpx}
