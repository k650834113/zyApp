<view class="home-page page-shell">
  <view wx:if="{{loading}}" class="empty-state">正在加载会员信息…</view>

  <block wx:elif="{{member}}">
    <view class="profile-row account-profile" bindtap="goProfile">
      <image wx:if="{{member.avatarUrl}}" class="avatar" src="{{member.avatarUrl}}" mode="aspectFill"/>
      <view wx:else class="avatar avatar-fallback">{{member.avatarText}}</view>
      <view class="profile-copy"><view class="profile-identity"><text class="profile-name">{{member.nickname}}</text><text class="member-tier">{{member.tierText}}</text></view><text class="profile-edit">编辑资料 ›</text></view><text>›</text>
    </view>
    <view class="account-balance"><view class="balance-caption"><text>门店预存款余额</text><text>仅限到店消费</text></view><text class="balance-number">{{member.totalBalanceText}}</text><view class="balance-actions"><button bindtap="goRecharge">充值</button><button bindtap="goHistory">收支明细</button></view></view>
    <view class="account-month" bindtap="goMonthlyCard"><image src="/assets/icons/receipt-green.svg"/><view><text class="month-title">月卡</text><text class="month-subtitle">{{member.monthlyCardText}}</text></view><button>{{monthlyCardState === 'active' ? '续费' : '查看'}}</button></view>
    <view class="account-tiles"><view bindtap="goMyMeetups"><image src="/assets/icons/people-green.svg"/><text>我的约局 ›</text></view><view bindtap="goPlays"><image src="/assets/icons/receipt-green.svg"/><text>对局记录 ›</text></view><view bindtap="goFavorites"><image src="/assets/icons/heart-green.svg"/><text>我喜欢的 ›</text></view></view>
  </block>

  <view wx:else class="guest-panel">
    <image class="guest-landscape" src="/assets/images/guest-landscape-v1.png" mode="aspectFill"/>
    <view class="guest-identity"><image class="guest-avatar" src="/assets/icons/user-muted.svg"/><view class="guest-welcome"><text class="guest-title">欢迎来到{{storeName || '桌游门店'}}</text><button class="guest-login" bindtap="goLogin">登录 / 注册</button><text class="guest-copy">注册后可参与约局、保存对局</text></view></view>
    <view class="account-tiles"><view bindtap="goMyMeetups"><image src="/assets/icons/people-green.svg"/><text>我的约局</text><text class="tile-hint">登录后查看</text></view><view bindtap="goPlays"><image src="/assets/icons/receipt-green.svg"/><text>对局记录</text><text class="tile-hint">登录后查看</text></view><view bindtap="goFavorites"><image src="/assets/icons/heart-green.svg"/><text>我喜欢的</text><text class="tile-hint">查看收藏</text></view></view>
  </view>

  <view class="account-menu">
    <view wx:if="{{employee}}" bindtap="goStaffWorkbench"><image src="/assets/icons/store-green.svg"/><text>员工工作台</text><text class="menu-arrow">›</text></view>
    <view wx:if="{{member}}" bindtap="goMessages"><image src="/assets/icons/receipt-green.svg"/><text>消息中心</text><text class="menu-arrow">›</text></view>
    <view bindtap="scanRegistration"><image src="/assets/icons/people-green.svg"/><text>扫码报名活动</text><text class="menu-arrow">›</text></view>
    <view wx:if="{{member}}" bindtap="goFriends"><image src="/assets/icons/people-green.svg"/><text>我的好友</text><text class="menu-arrow">›</text></view>
    <view bindtap="goAbout"><image src="/assets/icons/store-green.svg"/><text>关于门店</text><text class="menu-arrow">›</text></view>
    <view wx:if="{{!member}}" bindtap="goAbout"><image src="/assets/icons/pin-green.svg"/><text>到店导航</text><text class="menu-arrow">›</text></view>
    <view wx:if="{{!member}}" bindtap="goPricing"><image src="/assets/icons/receipt-green.svg"/><text>收费说明</text><text class="menu-arrow">›</text></view>
    <view bindtap="goAbout"><image src="/assets/icons/user-green.svg"/><text>联系门店</text><text class="menu-arrow">›</text></view>
    <view bindtap="goSettings"><image src="/assets/icons/tools-green.svg"/><text>设置与隐私</text><text class="menu-arrow">›</text></view>
  </view>
  <ui-nav active="member"/>
</view>
