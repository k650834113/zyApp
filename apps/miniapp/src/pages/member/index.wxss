.home-page {
  padding-top: 0;
}

.member-hero {
  margin: 0 -28rpx;
  padding: 42rpx 44rpx 92rpx;
  color: #fff;
  background:
    radial-gradient(circle at 88% 12%, rgba(255, 255, 255, 0.1), transparent 32%),
    linear-gradient(145deg, #103e30, #1d5d44);
}

.profile-row,
.profile-name-row,
.recharge-result,
.activity-row {
  display: flex;
  align-items: center;
}

.avatar {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  border: 5rpx solid rgba(255, 255, 255, 0.85);
  border-radius: 50%;
  background: #e9dfcf;
}

.avatar-fallback {
  color: #174f3b;
  font-size: 46rpx;
  font-weight: 700;
}

.profile-copy {
  min-width: 0;
  flex: 1;
  margin-left: 24rpx;
}

.profile-name-row {
  justify-content: space-between;
  min-width: 0;
}

.profile-identity {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: center;
}

.profile-name {
  overflow: hidden;
  min-width: 0;
  font-size: 34rpx;
  flex: 0 1 auto;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-tier {
  flex: 0 0 auto;
  margin-left: 14rpx;
  border-radius: 999rpx;
  padding: 5rpx 12rpx;
  color: #174f3b;
  background: rgba(255, 255, 255, 0.84);
  font-size: 20rpx;
  font-weight: 700;
}

.edit-profile {
  box-sizing: border-box;
  width: 76rpx;
  min-width: 76rpx;
  max-width: 76rpx;
  height: 50rpx;
  min-height: 50rpx;
  flex: 0 0 76rpx;
  margin: 0 0 0 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 14rpx;
  padding: 0;
  color: #fff;
  background: transparent;
  font-size: 22rpx;
  line-height: 48rpx;
}

.phone-text {
  display: block;
  margin-top: 8rpx;
  color: #d5e4dc;
  font-size: 23rpx;
}

.balance-card {
  position: relative;
  z-index: 2;
  margin-top: -58rpx;
  padding: 34rpx 34rpx 28rpx;
  overflow: hidden;
}

.balance-card::after {
  position: absolute;
  right: -24rpx;
  top: 30rpx;
  color: rgba(200, 121, 23, 0.13);
  content: "♟";
  font-size: 146rpx;
  transform: rotate(-8deg);
}

.balance-label,
.balance-value,
.result-title,
.result-copy,
.activity-title,
.activity-meta,
.activity-amount,
.activity-status {
  display: block;
}

.balance-label {
  font-size: 29rpx;
  font-weight: 700;
}

.balance-value {
  position: relative;
  z-index: 1;
  margin-top: 20rpx;
  color: #174f3b;
  font-size: 58rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.balance-scope-note {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 12rpx;
  color: #747870;
  font-size: 21rpx;
}

.monthly-card-feature {
  position: relative;
  margin-top: 24rpx;
  padding: 32rpx;
  overflow: hidden;
  color: #fff;
  background:
    radial-gradient(circle at 92% 8%, rgba(255, 225, 158, 0.34), transparent 35%),
    linear-gradient(140deg, #b9640a, #dd9027);
  box-shadow: 0 18rpx 42rpx rgba(177, 98, 13, 0.24);
}

.monthly-card-feature::after {
  position: absolute;
  right: -14rpx;
  bottom: -56rpx;
  color: rgba(255, 255, 255, 0.1);
  content: "月";
  font-size: 180rpx;
  font-weight: 800;
  transform: rotate(-10deg);
}

.monthly-card-feature-head {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.monthly-card-eyebrow,
.monthly-card-feature-title,
.monthly-card-price,
.monthly-card-plan-price,
.monthly-card-state,
.monthly-card-blocked {
  display: block;
}

.monthly-card-eyebrow {
  color: rgba(255, 255, 255, 0.78);
  font-size: 21rpx;
  letter-spacing: 4rpx;
}

.monthly-card-feature-title {
  margin-top: 8rpx;
  font-size: 33rpx;
  font-weight: 800;
}

.monthly-card-badge {
  border: 1rpx solid rgba(255, 255, 255, 0.58);
  border-radius: 999rpx;
  padding: 7rpx 14rpx;
  background: rgba(92, 43, 0, 0.18);
  font-size: 20rpx;
  font-weight: 700;
}

.monthly-card-price {
  position: relative;
  z-index: 1;
  margin-top: 24rpx;
  font-size: 48rpx;
  font-weight: 900;
}

.monthly-card-expiry {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
}

.monthly-card-expiry-label {
  color: rgba(255, 255, 255, 0.8);
  font-size: 22rpx;
}

.monthly-card-expiry-date {
  font-size: 56rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.monthly-card-remaining-days {
  border: 1rpx solid rgba(255, 255, 255, 0.58);
  border-radius: 999rpx;
  padding: 6rpx 12rpx;
  background: rgba(92, 43, 0, 0.18);
  font-size: 20rpx;
  font-weight: 700;
}

.monthly-card-paused-badge {
  background: rgba(92, 43, 0, 0.36);
}

.monthly-card-plan-price {
  position: relative;
  z-index: 1;
  margin-top: 18rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.monthly-card-state {
  position: relative;
  z-index: 1;
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 23rpx;
  line-height: 1.55;
}

.monthly-card-scope-note {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.24);
  padding-top: 18rpx;
  color: rgba(255, 255, 255, 0.86);
  font-size: 21rpx;
  line-height: 1.55;
}

.monthly-card-button {
  position: relative;
  z-index: 1;
  margin-top: 25rpx;
  color: #9e5007;
  background: #fff9ec;
  box-shadow: 0 12rpx 26rpx rgba(92, 43, 0, 0.18);
}

.monthly-card-button[disabled] {
  color: rgba(104, 61, 22, 0.55);
  background: rgba(255, 249, 236, 0.68);
}

.monthly-card-renew-button {
  position: relative;
  z-index: 1;
  width: 220rpx;
  margin: 25rpx 0 0;
  border-radius: 999rpx;
  padding: 0 20rpx;
  color: #9e5007;
  background: #fff9ec;
  box-shadow: 0 12rpx 26rpx rgba(92, 43, 0, 0.18);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 68rpx;
}

.monthly-card-renew-button[disabled] {
  color: rgba(104, 61, 22, 0.55);
  background: rgba(255, 249, 236, 0.68);
}

.monthly-card-blocked {
  position: relative;
  z-index: 1;
  margin-top: 14rpx;
  color: #fff5e3;
  font-size: 21rpx;
  text-align: center;
}

.recharge-card {
  margin-top: 24rpx;
  padding: 28rpx;
}

.recharge-heading {
  margin-bottom: 22rpx;
}

.recharge-scope-note {
  margin: 0 0 22rpx;
  border-radius: 14rpx;
  padding: 16rpx 18rpx;
  color: #315c49;
  background: #edf6f1;
  font-size: 21rpx;
  line-height: 1.55;
}

.recharge-title,
.recharge-subtitle,
.recharge-hint {
  display: block;
}

.recharge-title {
  font-size: 29rpx;
  font-weight: 700;
}

.recharge-subtitle {
  margin-top: 7rpx;
  font-size: 22rpx;
}

.recharge-options {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.recharge-option {
  display: flex;
  min-height: 138rpx;
  width: 100%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 0;
  border: 2rpx solid #e5dccf;
  border-radius: 18rpx;
  padding: 14rpx 8rpx;
  color: #174f3b;
  background: #fffdf9;
  line-height: 1.35;
}

.recharge-option.selected {
  border-color: #174f3b;
  color: #fff;
  background: #174f3b;
}

.recharge-option-amount,
.recharge-gift-estimate,
.recharge-total-estimate {
  display: block;
}

.recharge-option-amount {
  font-size: 29rpx;
  font-weight: 800;
}

.recharge-gift-estimate {
  margin-top: 5rpx;
  color: #c66f0b;
  font-size: 21rpx;
  font-weight: 700;
}

.recharge-total-estimate {
  margin-top: 3rpx;
  color: #747870;
  font-size: 19rpx;
}

.recharge-option.selected .recharge-gift-estimate,
.recharge-option.selected .recharge-total-estimate {
  color: rgba(255, 255, 255, 0.88);
}

.custom-recharge {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  border: 2rpx solid #e5dccf;
  border-radius: 18rpx;
  padding: 0 22rpx;
  background: #fffdf9;
}

.custom-currency {
  color: #174f3b;
  font-size: 34rpx;
  font-weight: 700;
}

.custom-recharge-input {
  height: 84rpx;
  flex: 1;
  margin-left: 14rpx;
  color: #202923;
  font-size: 29rpx;
}

.recharge-button {
  margin-top: 20rpx;
  box-shadow: 0 14rpx 28rpx rgba(23, 79, 59, 0.2);
}

.recharge-hint {
  font-size: 21rpx;
}

.recharge-rule-note {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-top: 16rpx;
}

.recharge-rule-info {
  display: flex;
  box-sizing: border-box;
  width: 42rpx;
  min-width: 42rpx;
  max-width: 42rpx;
  height: 42rpx;
  min-height: 42rpx;
  flex: 0 0 42rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  border: 2rpx solid #b7b4ac;
  border-radius: 50%;
  padding: 0;
  color: #686b64;
  background: transparent;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
}

.recharge-result {
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 24rpx;
}

.result-title {
  font-size: 27rpx;
  font-weight: 700;
}

.result-copy {
  margin-top: 8rpx;
}

.small-action {
  margin: 0;
  border-radius: 16rpx;
  padding: 0 20rpx;
  color: #fff;
  background: #174f3b;
  font-size: 23rpx;
  line-height: 62rpx;
}

.activity-list {
  padding: 0 24rpx;
}

.activity-row {
  min-height: 126rpx;
  border-bottom: 1rpx solid #eee5d9;
}

.activity-row:last-child {
  border-bottom: 0;
}

.activity-icon {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  color: #fff;
  background: #174f3b;
  font-size: 25rpx;
  font-weight: 700;
}

.activity-icon.recharge,
.activity-icon.monthly_card {
  background: #c87917;
}

.activity-main {
  min-width: 0;
  flex: 1;
  margin-left: 20rpx;
}

.activity-title {
  font-size: 27rpx;
  font-weight: 700;
}

.activity-meta {
  overflow: hidden;
  margin-top: 8rpx;
  color: #8a8a83;
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.activity-right {
  margin-left: 12rpx;
  text-align: right;
}

.activity-amount {
  font-size: 27rpx;
  font-weight: 700;
}

.activity-amount.credit {
  color: #c66f0b;
}

.activity-status {
  margin-top: 8rpx;
  color: #28704f;
  font-size: 21rpx;
}

.guest-panel {
  padding: 90rpx 20rpx 30rpx;
  text-align: center;
}

.guest-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 150rpx;
  height: 150rpx;
  margin: 0 auto;
  border-radius: 50%;
  color: #fff;
  background: linear-gradient(145deg, #103e30, #246449);
  font-size: 60rpx;
  font-weight: 800;
  box-shadow: 0 18rpx 42rpx rgba(23, 79, 59, 0.2);
}

.guest-title,
.guest-copy {
  display: block;
}

.guest-title {
  margin-top: 36rpx;
  font-size: 38rpx;
  font-weight: 700;
}

.guest-copy {
  max-width: 540rpx;
  margin: 18rpx auto 0;
  color: #7f817b;
  font-size: 25rpx;
  line-height: 1.7;
}

@media (max-width: 340px) {
  .edit-profile {
    width: 68rpx;
    min-width: 68rpx;
    max-width: 68rpx;
    flex-basis: 68rpx;
    margin-left: 8rpx;
  }

  .member-tier {
    margin-left: 8rpx;
    padding: 4rpx 8rpx;
    font-size: 18rpx;
  }
}

.login-button {
  margin-top: 52rpx;
}

.fallback-card {
  margin-top: 28rpx;
  padding: 28rpx;
  text-align: left;
}

.fallback-title {
  font-size: 28rpx;
  font-weight: 700;
}

.code-row {
  display: flex;
  gap: 14rpx;
  margin-top: 16rpx;
}

.code-row .form-input {
  margin: 0;
}

.code-input {
  min-width: 0;
  flex: 1;
}

.code-button {
  flex: 0 0 200rpx;
  margin: 0;
  border-radius: 20rpx;
  color: #174f3b;
  background: #ede7dc;
  font-size: 23rpx;
  line-height: 88rpx;
}

.hint {
  display: block;
  margin-top: 14rpx;
}

.personal-links { margin-top: 28rpx; padding: 12rpx 24rpx; }
.personal-links button { text-align: left; background: transparent; line-height: 86rpx; font-size: 28rpx; }
.guest-panel {padding:0; text-align:left; background:transparent}
.guest-landscape {display:block;width:750rpx;height:260rpx;margin:0 -28rpx}
.guest-identity {display:flex;align-items:center;gap:28rpx;margin:0 4rpx 38rpx}
.guest-avatar {width:150rpx;height:150rpx;padding:20rpx;box-sizing:border-box;background:#e8e8e7;border-radius:50%;flex-shrink:0}
.guest-welcome {flex:1;min-width:0}
.guest-welcome .guest-title {font-size:32rpx;font-weight:700;margin:0 0 20rpx;display:block}
.guest-login {background:#175540;color:white;border-radius:48rpx;font-size:30rpx;line-height:72rpx;padding:0}
.guest-welcome .guest-copy {font-size:23rpx;color:#777;margin:14rpx 0 0;display:block}
.account-tiles {display:flex;gap:14rpx;margin:22rpx 0 28rpx}
.account-tiles>view {flex:1;min-width:0;background:white;border:1rpx solid #e4e5e3;border-radius:18rpx;display:flex;flex-direction:column;align-items:center;padding:30rpx 8rpx;gap:14rpx;font-size:28rpx}
.account-tiles image {width:44rpx;height:44rpx}
.account-tiles .tile-hint {font-size:22rpx;color:#85878b}
.account-menu {padding:0 28rpx;background:#fff;border:1rpx solid #e4e5e3;border-radius:18rpx;margin:24rpx 0}
.account-menu>view {display:flex;align-items:center;gap:24rpx;min-height:96rpx;border-bottom:1rpx solid #ebebeb;font-size:28rpx}
.account-menu>view:last-child {border:0}
.account-menu image {width:42rpx;height:42rpx}
.menu-arrow {margin-left:auto;color:#888;font-size:38rpx}
.account-profile{padding:34rpx 8rpx;color:#172029;margin-bottom:28rpx}.account-profile .avatar{width:150rpx;height:150rpx;border:0}.account-profile .profile-copy{margin-left:28rpx}.account-profile .member-tier{background:#f9e8c7;color:#966526}.profile-edit{display:block;font-size:25rpx;color:#727479;margin-top:24rpx}.account-balance{background:linear-gradient(120deg,#174f3b,#21604c);border-radius:16rpx;padding:30rpx;color:white}.balance-caption{display:flex;justify-content:space-between;font-size:28rpx}.balance-caption text:last-child{font-size:23rpx;opacity:.75}.balance-number{display:block;font-size:62rpx;font-weight:700;margin:14rpx 0 26rpx}.balance-actions{display:flex;gap:24rpx}.balance-actions button{width:50%;font-size:28rpx;line-height:76rpx;border-radius:12rpx;color:#174f3b;background:#fbf9f3;padding:0}.balance-actions button:last-child{color:white;background:transparent;border:2rpx solid #d3e3db}.account-month{display:flex;align-items:center;gap:22rpx;padding:28rpx;background:white;border:1rpx solid #e4e5e3;border-radius:16rpx;margin-top:24rpx}.account-month image{width:56rpx;height:56rpx}.account-month>view{flex:1;min-width:0}.month-title{display:block;font-size:32rpx}.month-subtitle{display:block;font-size:23rpx;color:#777;margin-top:10rpx}.account-month button{width:140rpx;padding:0;line-height:62rpx;font-size:26rpx;color:white;background:#175540;border-radius:40rpx;margin:0}
.guest-welcome .guest-login{width:100%;box-sizing:border-box}

.account-balance{border-radius:28rpx;box-shadow:0 12rpx 30rpx rgba(23,79,59,.12)}.account-month,.account-menu,.account-tiles>view{border-color:#e5e8df;border-radius:24rpx;background:#fffdf8}.guest-panel{border-radius:28rpx;overflow:hidden;border:1rpx solid #e5e8df}.guest-title{line-height:1.5}
