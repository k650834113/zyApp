<view class="page-shell workspace-page"><text class="heading">消息中心</text><text wx:if="{{error}}" class="error">{{error}}</text><button wx:if="{{error}}" bindtap="refresh">重试</button><view wx:if="{{!member}}" class="card"><text class="muted">登录后查看与你有关的业务消息。</text><button bindtap="login">注册 / 登录</button></view><view wx:elif="{{selected}}" class="card"><text class="section-title">{{selected.title}}</text><text class="muted">{{selected.timeText}}</text><text class="notice-body">{{selected.body}}</text><button wx:if="{{selected.scene === 'lottery.result' && selected.businessId && !selected.test}}" bindtap="result">查看我的开奖结果</button><button class="secondary" bindtap="close">返回消息列表</button></view><block wx:else><view wx:for="{{items}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="open"><text class="section-title"><text wx:if="{{!item.read}}" class="unread">● </text>{{item.title}}</text><text class="notice-body">{{item.body}}</text><text class="muted">{{item.timeText}} ›</text></view><text wx:if="{{!items.length}}" class="muted">暂无消息。</text><button wx:if="{{hasMore}}" bindtap="more" loading="{{busy}}">加载更多</button><view wx:if="{{scenes.length}}" class="card"><text class="section-title">微信提醒</text><text class="muted">按需开启，每次订阅获得一次对应提醒机会；业务记录始终保存在小程序中。</text><view wx:for="{{scenes}}" wx:key="key"><text>{{item.title}}</text><text class="muted">{{item.description}}</text><notice-subscribe scene="{{item.key}}" label="订阅一次提醒"/></view></view></block></view>
