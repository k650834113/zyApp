<view class="home-page page-shell">
  <view wx:if="{{loading}}" class="empty-state">正在加载会员信息…</view>

  <block wx:elif="{{member}}">
    <view class="member-hero">
      <view class="profile-row">
        <image wx:if="{{member.avatarUrl}}" class="avatar" src="{{member.avatarUrl}}" mode="aspectFill" />
        <view wx:else class="avatar avatar-fallback">{{member.avatarText}}</view>
        <view class="profile-copy">
          <view class="profile-name-row">
            <view class="profile-identity">
              <text class="profile-name">{{member.nickname}}</text>
              <text class="member-tier">{{member.tierText}}</text>
            </view>
            <button class="edit-profile" bindtap="goProfile">编辑</button>
          </view>
          <text class="phone-text">{{member.phoneMasked}}</text>
        </view>
      </view>
    </view>

    <view class="balance-card card">
      <text class="balance-label">储值余额</text>
      <text class="balance-value">{{member.totalBalanceText}}</text>
    </view>

    <view wx:if="{{monthlyCardEnabled && monthlyCardConfiguration}}" class="monthly-card-feature card">
      <view class="monthly-card-feature-head">
        <view>
          <text class="monthly-card-eyebrow">桌游畅玩月卡</text>
          <text class="monthly-card-feature-title">{{monthlyCardConfiguration.planName}}</text>
        </view>
        <text class="monthly-card-badge">{{monthlyCardState === 'active' ? '续费顺延' : monthlyCardState === 'paused' ? '已暂停' : '立即生效'}}</text>
      </view>
      <block wx:if="{{monthlyCardState === 'unopened'}}">
        <text class="monthly-card-price">{{monthlyCardPriceText}}</text>
        <text class="monthly-card-state">{{monthlyCardStatusText}}</text>
        <button
          class="primary-button monthly-card-button"
          loading="{{busy}}"
          disabled="{{busy || !monthlyCardConfiguration.purchaseAllowed}}"
          bindtap="purchaseMonthlyCard"
        >{{monthlyCardActionText}}</button>
      </block>
      <block wx:elif="{{monthlyCardState === 'active'}}">
        <view class="monthly-card-expiry">
          <text class="monthly-card-expiry-label">有效期至</text>
          <text class="monthly-card-expiry-date">{{monthlyCardExpiresOn}}</text>
          <text class="monthly-card-remaining-days">{{monthlyCardRemainingDaysText}}</text>
        </view>
        <text class="monthly-card-plan-price">{{monthlyCardPriceText}}</text>
        <text class="monthly-card-state">{{monthlyCardStatusText}}</text>
        <button
          class="monthly-card-renew-button"
          loading="{{busy}}"
          disabled="{{busy || !monthlyCardConfiguration.purchaseAllowed}}"
          bindtap="purchaseMonthlyCard"
        >{{monthlyCardActionText}}</button>
      </block>
      <block wx:else>
        <view class="monthly-card-expiry">
          <text class="monthly-card-expiry-label">有效期至</text>
          <text class="monthly-card-expiry-date">{{monthlyCardExpiresOn}}</text>
          <text class="monthly-card-remaining-days monthly-card-paused-badge">已暂停</text>
        </view>
        <text class="monthly-card-plan-price">{{monthlyCardPriceText}}</text>
        <text class="monthly-card-blocked">{{monthlyCardConfiguration.blockedReason || monthlyCardStatusText}}</text>
        <button
          class="monthly-card-renew-button"
          disabled
        >{{monthlyCardActionText}}</button>
      </block>
    </view>

    <view wx:if="{{rechargeEnabled}}" class="recharge-card card">
      <view class="recharge-heading">
        <text class="recharge-title">微信充值</text>
        <text class="muted recharge-subtitle">选择快捷金额或输入自定义金额</text>
      </view>
      <view class="recharge-options">
        <button
          wx:for="{{quickRechargeAmounts}}"
          wx:key="principalFen"
          class="recharge-option {{selectedRechargeAmountFen == item.principalFen ? 'selected' : ''}}"
          data-principal-fen="{{item.principalFen}}"
          disabled="{{busy}}"
          bindtap="selectRechargeAmount"
        >{{item.label}}</button>
      </view>
      <view class="custom-recharge">
        <text class="custom-currency">¥</text>
        <input
          class="custom-recharge-input"
          type="digit"
          value="{{customRechargeAmount}}"
          disabled="{{busy}}"
          placeholder="自定义金额，最低 0.01 元"
          bindinput="inputCustomRechargeAmount"
        />
      </view>
      <button
        class="primary-button recharge-button"
        loading="{{busy}}"
        disabled="{{busy}}"
        bindtap="recharge"
      >微信支付</button>
      <text class="muted recharge-hint">实际赠送金额按门店当前充值规则计算</text>
    </view>

    <view wx:if="{{rechargeOrder}}" class="recharge-result card">
      <view>
        <text class="result-title">{{rechargeOrder.statusText}}</text>
        <text class="muted result-copy">预计到账 {{rechargeOrder.amountText}}</text>
      </view>
      <button
        wx:if="{{rechargeOrder.providerMode === 'mock' && rechargeOrder.status === 'pending_payment'}}"
        class="small-action"
        bindtap="settleMockRecharge"
      >完成测试支付</button>
    </view>

    <view class="section-head">
      <text class="section-title">最近明细</text>
      <text class="section-link" bindtap="goHistory">全部明细 〉</text>
    </view>
    <view class="activity-list card">
      <view wx:if="{{recentActivities.length === 0}}" class="empty-state">暂无明细</view>
      <view wx:for="{{recentActivities}}" wx:key="activityId" class="activity-row">
        <view class="activity-icon {{item.kind}}">{{item.iconText}}</view>
        <view class="activity-main">
          <text class="activity-title">{{item.title}}</text>
          <text class="activity-meta">{{item.timeText}}　{{item.businessNumber ? '单号：' + item.businessNumber : ''}}</text>
        </view>
        <view class="activity-right">
          <text class="activity-amount {{item.amountClass}}">{{item.amountText}}</text>
          <text class="activity-status">{{item.statusText}}</text>
        </view>
      </view>
    </view>
  </block>

  <view wx:else class="guest-panel">
    <view class="guest-mark">会</view>
    <text class="guest-title">登录会员账户</text>
    <text class="guest-copy">查询余额、月卡和历史明细，并使用微信安全充值。</text>
    <button
      class="primary-button login-button"
      open-type="getPhoneNumber"
      bindgetphonenumber="loginWithWechat"
      loading="{{busy}}"
    >微信会员登录</button>
    <button
      wx:if="{{testVirtualPhoneLoginEnabled}}"
      class="secondary-button"
      bindtap="loginWithVirtualPhone"
    >测试环境真实微信登录</button>

    <view wx:if="{{loginFallbackVisible}}" class="fallback-card card">
      <text class="fallback-title">手机号验证码登录</text>
      <input class="form-input" type="number" maxlength="11" placeholder="手机号" bindinput="inputPhone" />
      <view class="code-row">
        <input class="form-input code-input" type="number" maxlength="8" placeholder="验证码" bindinput="inputCode" />
        <button class="code-button" bindtap="requestVerification" loading="{{verificationBusy}}">获取验证码</button>
      </view>
      <text wx:if="{{loginHint}}" class="muted hint">{{loginHint}}</text>
      <button class="primary-button" bindtap="submitFallbackLogin" loading="{{busy}}">登录并完善资料</button>
    </view>
  </view>

  <view class="bottom-nav">
    <view class="nav-item active" bindtap="goHome"><text class="nav-icon">⌂</text><text>首页</text></view>
    <view class="nav-item" bindtap="goHistory"><text class="nav-icon">▤</text><text>明细</text></view>
    <view class="nav-item" bindtap="goProfile"><text class="nav-icon">○</text><text>我的</text></view>
  </view>
</view>
