<view class="page-shell discovery-page">
  <swiper class="activity-banner" indicator-dots="{{bannerActivities.length > 0}}" indicator-active-color="#174f3b" autoplay="{{bannerActivities.length > 0}}" interval="6000" circular>
    <swiper-item><view class="banner-inner" bindtap="goGames"><ui-art kind="hero" class="banner-image" src="{{heroUrl}}" mode="aspectFill"/><view class="banner-copy"><ui-art wx:if="{{!heroTitle || heroTitle === home.store.name}}" kind="logo" class="banner-brand"/><text wx:else class="banner-title">{{heroTitle}}</text><text class="banner-summary">{{heroSubtitle}}</text></view></view></swiper-item>
    <swiper-item wx:for="{{bannerActivities}}" wx:key="id"><view class="banner-inner" data-id="{{item.id}}" bindtap="goActivity"><activity-cover src="{{item.coverUrl}}" title="{{item.coverTitle}}" status="{{item.statusText}}" date="{{item.coverDateText}}"/></view></swiper-item>
  </swiper>
  <view class="store-links"><view bindtap="goAbout"><image src="/assets/icons/pin-green.svg"/>到店导航<text>›</text></view><view bindtap="goPricing"><image src="/assets/icons/receipt-green.svg"/>收费说明<text>›</text></view></view>
  <view class="shortcuts">
    <view bindtap="goGames"><image src="/assets/icons/search-green.svg"/><text>找桌游</text><text class="muted">按喜好发现</text></view>
    <view bindtap="goTools"><image src="/assets/icons/tools-green.svg"/><text>桌游工具</text><text class="muted">计分 · 分队</text></view>
    <view bindtap="goRecord"><image src="/assets/icons/edit-green.svg"/><text>记录对局</text><text class="muted">留住精彩时刻</text></view>
  </view>
  <view wx:if="{{errorMessage}}" class="notice"><text>{{errorMessage}}</text><button bindtap="load">重新加载</button></view>
  <view wx:if="{{loading}}" class="empty-state">正在加载门店内容…</view>
  <view class="section-head"><text class="section-title">店家推荐</text><text class="section-link" bindtap="goRecommendations">查看全部 ›</text></view>
  <view class="recommendation-grid" wx:if="{{home.recommendedGames.length}}">
    <view wx:for="{{home.recommendedGames}}" wx:key="id" class="recommendation-card" data-id="{{item.id}}" bindtap="goGameDetail">
      <image wx:if="{{item.imageUrl}}" class="recommendation-cover" src="{{item.imageUrl}}" mode="aspectFill" data-id="{{item.id}}" binderror="imageError"/><view wx:else class="cover-placeholder">桌游</view>
      <view class="recommendation-title"><text class="game-name">{{item.name}}</text><image src="/assets/icons/heart-{{item.likedByViewer ? 'green' : 'muted'}}.svg" data-id="{{item.id}}" catchtap="likeRecommendation"/></view>
      <text class="recommendation-note">{{item.customerNote || item.minPlayers + '–' + item.maxPlayers + '人'}}</text>
    </view>
  </view>
  <view wx:elif="{{!loading}}" class="quiet-empty">店家正在挑选推荐，也可以先逛逛桌游库。</view>
  <view class="section-head"><text class="section-title">近期活动</text><text class="section-link" bindtap="goActivities">查看全部 ›</text></view>
  <view wx:for="{{activities}}" wx:key="id" class="event-row" data-id="{{item.id}}" bindtap="goActivity">
    <activity-cover class="event-cover" src="{{item.coverUrl}}" compact="{{true}}"/>
    <view class="event-copy"><view class="event-heading"><text class="event-title">{{item.title}}</text><text class="event-status">{{item.statusText}}</text></view><text class="event-time">{{item.startsAtText}}</text><text class="event-summary">{{item.summary}}</text></view><text class="event-arrow">›</text>
  </view>
  <view wx:if="{{!loading && !activities.length}}" class="quiet-empty">暂无近期活动，过段时间再来看看。</view>
  <text wx:if="{{home.recommendedGames.length}}" class="attribution">Powered by BGG</text>
  <ui-nav active="home"/>
</view>
