.discovery-page{padding:0 28rpx calc(130rpx + env(safe-area-inset-bottom));background:#fbf7ef;color:#17201d}
.activity-banner{position:relative;margin:0 -28rpx;height:350rpx;overflow:hidden;border-radius:0 0 16rpx 16rpx;background:#174f3b}.banner-inner{position:relative;height:100%}.banner-image{width:100%;height:100%}.banner-copy{position:absolute;top:45rpx;left:20rpx;right:20rpx;text-align:center;color:#fff;text-shadow:0 2rpx 8rpx #30291c}.banner-title{display:block;font-size:60rpx;font-family:KaiTi,STKaiti,serif;font-weight:700;letter-spacing:5rpx}.banner-summary{display:block;margin-top:10rpx;font-size:25rpx;letter-spacing:4rpx}
.store-links{height:86rpx;display:grid;grid-template-columns:1fr 1fr;align-items:center;margin:0 -28rpx;background:#fff}.store-links>view{display:flex;align-items:center;justify-content:center;gap:10rpx;color:#174f3b;font-size:24rpx}.store-links>view+view{border-left:1rpx solid #d5d8d2}.store-links image{width:29rpx;height:29rpx}
.shortcuts{display:grid;grid-template-columns:repeat(3,1fr);gap:16rpx;margin-top:16rpx}.shortcuts>view{display:flex;flex-direction:column;align-items:center;justify-content:center;height:194rpx;border-radius:17rpx;background:#f4f0e9}.shortcuts image{width:55rpx;height:55rpx;margin-bottom:20rpx}.shortcuts text{font-size:27rpx;font-weight:600}.shortcuts .muted{font-size:22rpx;font-weight:400;color:#828580;margin-top:10rpx}
.section-head{margin:32rpx 0 20rpx}.section-title{font-size:31rpx;color:#151e19}.section-link{font-size:23rpx;color:#7b8184}
.recommendation-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20rpx}.recommendation-cover,.cover-placeholder{width:100%;height:230rpx;border-radius:12rpx;background:#e8e9df}.cover-placeholder{display:flex;align-items:center;justify-content:center;color:#174f3b}.recommendation-title{display:flex;align-items:center;justify-content:space-between;gap:10rpx;margin:12rpx 3rpx 8rpx}.game-name{font-size:27rpx;font-weight:600;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.recommendation-title image{width:31rpx;height:31rpx;flex-shrink:0}.recommendation-note{display:inline-block;max-width:100%;box-sizing:border-box;padding:5rpx 14rpx;border-radius:18rpx;background:#e2f1e9;color:#376b56;font-size:22rpx;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.event-row{display:flex;align-items:center;gap:16rpx;padding:0 12rpx 0 0;border:1rpx solid #e8e9e4;border-radius:14rpx;background:#fff;margin-bottom:16rpx;overflow:hidden}.event-cover{width:180rpx;height:132rpx;flex-shrink:0}.event-copy{min-width:0;flex:1}.event-heading{display:flex;align-items:center;gap:12rpx}.event-title{font-size:27rpx;font-weight:600}.event-status{font-size:20rpx;background:#e2f1e9;color:#36765a;padding:3rpx 8rpx;border-radius:6rpx;white-space:nowrap}.event-time,.event-summary{display:block;font-size:22rpx;margin-top:7rpx;color:#67706a;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.event-summary{color:#92958f;font-size:21rpx}.event-arrow{font-size:36rpx}.quiet-empty,.notice{padding:22rpx 0;color:#7f817b;font-size:24rpx;line-height:1.7}.notice button{font-size:24rpx}.attribution{display:block;color:#92958f;font-size:18rpx;margin:14rpx 0}

.activity-banner{margin:20rpx 0 0;height:360rpx;border-radius:28rpx;box-shadow:0 12rpx 32rpx rgba(23,79,59,.12)}
.banner-image{display:block}.banner-copy{top:38rpx;left:30rpx;right:30rpx;text-align:left;pointer-events:none}
.banner-title{font-family:inherit;font-size:44rpx;line-height:1.3;letter-spacing:1rpx;max-width:560rpx}
.banner-summary{font-size:24rpx;letter-spacing:1rpx;max-width:500rpx;line-height:1.6}
.store-links{margin:14rpx 0 0;border:1rpx solid #e5e8df;border-radius:20rpx;background:#fffdf8;height:78rpx}
.shortcuts{gap:14rpx;margin-top:20rpx}.shortcuts>view{border:1rpx solid #e5e8df;border-radius:24rpx;background:#fffdf8;height:174rpx}.shortcuts image{width:48rpx;height:48rpx;margin-bottom:12rpx}
.recommendation-card{padding:12rpx;border:1rpx solid #e5e8df;border-radius:24rpx;background:#fffdf8;box-sizing:border-box;overflow:hidden}
.recommendation-cover,.cover-placeholder{border-radius:16rpx}.recommendation-title{margin-top:14rpx}.recommendation-note{margin-bottom:4rpx;font-size:21rpx}
.event-row{padding:12rpx;border-radius:22rpx;background:#fffdf8;gap:18rpx}.event-cover{border-radius:14rpx}.event-title{min-width:0;flex:1;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.event-status{flex-shrink:0}


.banner-brand{display:block;width:210rpx;height:118rpx;pointer-events:none}

.banner-title,.banner-summary{display:-webkit-box;-webkit-box-orient:vertical;overflow:hidden;overflow-wrap:break-word}.banner-title{-webkit-line-clamp:2}.banner-summary{-webkit-line-clamp:2}
