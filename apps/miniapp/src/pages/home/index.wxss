.home-page {
  padding-top: 0;
}

.member-hero {
  margin: 0 -28rpx;
  padding: 34rpx 44rpx 92rpx;
  color: #fff;
  background:
    radial-gradient(circle at 88% 12%, rgba(255, 255, 255, 0.1), transparent 32%),
    linear-gradient(145deg, #103e30, #1d5d44);
}

.page-title {
  margin-bottom: 36rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.profile-row,
.profile-name-row,
.recharge-result,
.activity-row {
  display: flex;
  align-items: center;
}

.avatar {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  border: 5rpx solid rgba(255, 255, 255, 0.85);
  border-radius: 50%;
  background: #e9dfcf;
}

.avatar-fallback {
  color: #174f3b;
  font-size: 46rpx;
  font-weight: 700;
}

.profile-copy {
  min-width: 0;
  margin-left: 24rpx;
}

.profile-name {
  overflow: hidden;
  max-width: 260rpx;
  font-size: 34rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-tier {
  margin-left: 10rpx;
  color: #d5e4dc;
  font-size: 25rpx;
}

.edit-profile {
  min-width: 84rpx;
  margin: 0 0 0 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 14rpx;
  padding: 0 14rpx;
  color: #fff;
  background: transparent;
  font-size: 22rpx;
  line-height: 48rpx;
}

.phone-text {
  display: block;
  margin-top: 8rpx;
  color: #d5e4dc;
  font-size: 23rpx;
}

.balance-card {
  position: relative;
  z-index: 2;
  margin-top: -58rpx;
  padding: 34rpx 34rpx 28rpx;
  overflow: hidden;
}

.balance-card::after {
  position: absolute;
  right: -24rpx;
  top: 30rpx;
  color: rgba(200, 121, 23, 0.13);
  content: "♟";
  font-size: 146rpx;
  transform: rotate(-8deg);
}

.balance-label,
.balance-value,
.monthly-card-text,
.result-title,
.result-copy,
.activity-title,
.activity-meta,
.activity-amount,
.activity-status {
  display: block;
}

.balance-label {
  font-size: 29rpx;
  font-weight: 700;
}

.balance-value {
  position: relative;
  z-index: 1;
  margin-top: 20rpx;
  color: #174f3b;
  font-size: 58rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.balance-divider {
  height: 1rpx;
  margin: 28rpx 0 22rpx;
  background: #eee5d9;
}

.monthly-card-text {
  color: #39443e;
  font-size: 25rpx;
}

.recharge-card {
  margin-top: 24rpx;
  padding: 28rpx;
}

.recharge-heading {
  margin-bottom: 22rpx;
}

.recharge-title,
.recharge-subtitle,
.recharge-hint {
  display: block;
}

.recharge-title {
  font-size: 29rpx;
  font-weight: 700;
}

.recharge-subtitle {
  margin-top: 7rpx;
  font-size: 22rpx;
}

.recharge-options {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.recharge-option {
  width: 100%;
  margin: 0;
  border: 2rpx solid #e5dccf;
  border-radius: 18rpx;
  color: #174f3b;
  background: #fffdf9;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 78rpx;
}

.recharge-option.selected {
  border-color: #174f3b;
  color: #fff;
  background: #174f3b;
}

.custom-recharge {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  border: 2rpx solid #e5dccf;
  border-radius: 18rpx;
  padding: 0 22rpx;
  background: #fffdf9;
}

.custom-currency {
  color: #174f3b;
  font-size: 34rpx;
  font-weight: 700;
}

.custom-recharge-input {
  height: 84rpx;
  flex: 1;
  margin-left: 14rpx;
  color: #202923;
  font-size: 29rpx;
}

.recharge-button {
  margin-top: 20rpx;
  box-shadow: 0 14rpx 28rpx rgba(23, 79, 59, 0.2);
}

.recharge-hint {
  margin-top: 16rpx;
  text-align: center;
  font-size: 21rpx;
}

.recharge-result {
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 24rpx;
}

.result-title {
  font-size: 27rpx;
  font-weight: 700;
}

.result-copy {
  margin-top: 8rpx;
}

.small-action {
  margin: 0;
  border-radius: 16rpx;
  padding: 0 20rpx;
  color: #fff;
  background: #174f3b;
  font-size: 23rpx;
  line-height: 62rpx;
}

.activity-list {
  padding: 0 24rpx;
}

.activity-row {
  min-height: 126rpx;
  border-bottom: 1rpx solid #eee5d9;
}

.activity-row:last-child {
  border-bottom: 0;
}

.activity-icon {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  color: #fff;
  background: #174f3b;
  font-size: 25rpx;
  font-weight: 700;
}

.activity-icon.recharge,
.activity-icon.monthly_card {
  background: #c87917;
}

.activity-main {
  min-width: 0;
  flex: 1;
  margin-left: 20rpx;
}

.activity-title {
  font-size: 27rpx;
  font-weight: 700;
}

.activity-meta {
  overflow: hidden;
  margin-top: 8rpx;
  color: #8a8a83;
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.activity-right {
  margin-left: 12rpx;
  text-align: right;
}

.activity-amount {
  font-size: 27rpx;
  font-weight: 700;
}

.activity-amount.credit {
  color: #c66f0b;
}

.activity-status {
  margin-top: 8rpx;
  color: #28704f;
  font-size: 21rpx;
}

.guest-panel {
  padding: 90rpx 20rpx 30rpx;
  text-align: center;
}

.guest-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 150rpx;
  height: 150rpx;
  margin: 0 auto;
  border-radius: 50%;
  color: #fff;
  background: linear-gradient(145deg, #103e30, #246449);
  font-size: 60rpx;
  font-weight: 800;
  box-shadow: 0 18rpx 42rpx rgba(23, 79, 59, 0.2);
}

.guest-title,
.guest-copy {
  display: block;
}

.guest-title {
  margin-top: 36rpx;
  font-size: 38rpx;
  font-weight: 700;
}

.guest-copy {
  max-width: 540rpx;
  margin: 18rpx auto 0;
  color: #7f817b;
  font-size: 25rpx;
  line-height: 1.7;
}

@media (max-width: 340px) {
  .member-tier {
    display: none;
  }

  .profile-name {
    max-width: 180rpx;
  }

  .edit-profile {
    min-width: 72rpx;
    margin-left: 10rpx;
    padding: 0 10rpx;
  }
}

.login-button {
  margin-top: 52rpx;
}

.fallback-card {
  margin-top: 28rpx;
  padding: 28rpx;
  text-align: left;
}

.fallback-title {
  font-size: 28rpx;
  font-weight: 700;
}

.code-row {
  display: flex;
  gap: 14rpx;
  margin-top: 16rpx;
}

.code-row .form-input {
  margin: 0;
}

.code-input {
  min-width: 0;
  flex: 1;
}

.code-button {
  flex: 0 0 200rpx;
  margin: 0;
  border-radius: 20rpx;
  color: #174f3b;
  background: #ede7dc;
  font-size: 23rpx;
  line-height: 88rpx;
}

.hint {
  display: block;
  margin-top: 14rpx;
}
