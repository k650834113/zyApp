<view class="page-shell workspace-page"><text class="heading">消息通知测试</text><text wx:if="{{error}}" class="error">{{error}}</text>
<view wx:if="{{employee}}" class="card"><text class="section-title">仅向本人发送</text><text class="muted">当前员工：{{identityName}}。测试消息有明确标记，不产生真实开奖、消费或充值；每分钟最多测试一次。</text>
<block wx:if="{{!member}}"><text class="muted">请先用当前微信注册会员，才能接收消息。</text><button bindtap="login">注册会员</button></block>
<block wx:else><button class="secondary" bindtap="inApp" disabled="{{busy || result}}">测试站内消息</button>
<block wx:if="{{scenes.length}}"><picker range="{{scenes}}" range-key="title" value="{{sceneIndex}}" bindchange="choose"><view class="picker">测试模板：{{scenes[sceneIndex].title}} ›</view></picker><notice-subscribe scene="{{scenes[sceneIndex].key}}" business-id="{{requestId}}" label="订阅并发送一条微信测试通知" disabled="{{busy || result}}" bindcomplete="subscribed"/></block><text wx:else class="muted">微信订阅模板尚未配置，当前可先测试站内消息。</text><button wx:if="{{manager}}" class="secondary" bindtap="settings">通知模板配置</button></block></view>
<view wx:if="{{result}}" class="card"><text class="section-title">{{statusText}}</text><text class="muted">消息编号：{{result.id}}</text><text wx:if="{{result.errorCode && result.errorCode !== 'in_app_only'}}" class="muted">微信返回码：{{result.errorCode}}</text><text class="notice-body">{{result.body}}</text><button bindtap="refresh">刷新发送状态</button><button class="secondary" bindtap="messages">到消息中心查看</button><button class="secondary" bindtap="newTest">新一轮测试</button></view></view>
