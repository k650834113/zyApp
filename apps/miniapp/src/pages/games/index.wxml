<view class="page">
  <view class="search-row">
    <input
      class="form-input search-input"
      placeholder="输入桌游名称或类型"
      value="{{query}}"
      bindinput="onQueryInput"
      confirm-type="search"
      bindconfirm="search"
    />
    <button class="search-button" bindtap="search">搜索</button>
  </view>

  <view class="card game" wx:for="{{games}}" wx:key="id">
    <view class="game-head">
      <text class="card-title">{{item.name}}</text>
    </view>
    <text class="muted block">{{item.introduction}}</text>
    <view class="tag-row">
      <text class="tag" wx:for="{{item.categories}}" wx:key="*this">{{item}}</text>
      <text class="tag good">{{item.minPlayers}}-{{item.maxPlayers}} 人</text>
      <text class="tag">{{item.durationText}}</text>
      <text class="tag">{{item.complexityText}}</text>
    </view>
    <text class="customer-note" wx:if="{{item.customerNote}}">{{item.customerNote}}</text>
  </view>

  <view class="empty" wx:if="{{!loading && games.length === 0}}">没有找到匹配的桌游</view>
  <view class="empty" wx:if="{{loading}}">正在筛选桌游...</view>
</view>
