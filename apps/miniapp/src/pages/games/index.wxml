<view class="page-shell library-page">
  <view class="search-row">
    <input
      class="form-input search-input"
      placeholder="搜索桌游名称"
      value="{{query}}"
      bindinput="onQueryInput"
      confirm-type="search"
      bindconfirm="search"
    />
    <button class="search-button" bindtap="search">搜索</button>
  </view>
  <view class="recommendation-entry" bindtap="goRecommendations" aria-role="button" aria-label="查看店家推荐">
    <view class="recommendation-icon"><image src="/assets/icons/store-green.svg" /></view>
    <view class="recommendation-copy"><text class="recommendation-title">店家推荐</text><text class="recommendation-subtitle">精选适合不同场景的桌游</text></view>
    <image class="recommendation-arrow" src="/assets/icons/arrow-muted.svg" />
  </view>

  <view class="quick-filters">
    <button class="filter-pill" data-filter-kind="category" bindtap="openFilter">分类</button>
    <button class="filter-pill" data-filter-kind="players" bindtap="openFilter">人数</button>
    <button class="filter-pill" data-filter-kind="minutes" bindtap="openFilter">时长</button>
    <button class="filter-pill" data-filter-kind="complexity" bindtap="openFilter">复杂度</button>
  </view>

  <view wx:if="{{selectedChips.length}}" class="selected-row">
    <view
      wx:for="{{selectedChips}}"
      wx:key="key"
      class="selected-chip"
      data-kind="{{item.kind}}"
      data-category="{{item.category}}"
      bindtap="removeChip"
    >{{item.label}} ×</view>
    <text class="clear-all" bindtap="clearAll">清空全部</text>
  </view>

  <view class="sort-control">
    <view class="sort-trigger {{sortOpen ? 'open' : ''}}" bindtap="toggleSort" aria-role="button" aria-label="选择桌游排序方式">
      <text>{{sortLabel}}</text>
      <text class="sort-caret">{{sortOpen ? '▲' : '▼'}}</text>
    </view>
    <view wx:if="{{sortOpen}}" class="sort-scrim" bindtap="closeSort"></view>
    <view wx:if="{{sortOpen}}" class="sort-menu" catchtap="noop">
      <view class="sort-menu-item {{sort === 'recent' ? 'active' : ''}}" data-sort="recent" bindtap="changeSort">最近更新</view>
      <view class="sort-menu-item {{sort === 'mostLiked' ? 'active' : ''}}" data-sort="mostLiked" bindtap="changeSort">最多喜爱</view>
    </view>
  </view>

  <view wx:if="{{loadFailed}}" class="load-error" bindtap="retry">
    加载失败，点击重试
  </view>
  <view wx:if="{{loading && games.length}}" class="loading-line">正在更新结果…</view>

  <view wx:for="{{games}}" wx:key="id" class="game-family">
    <board-game-card
      id="game-card-{{index}}"
      game="{{item}}"
      show-expansion-action="{{true}}"
      bindlike="likeGame"
      bindviewexpansions="goExpansions"
      bindimageerror="imageError"
    />
  </view>

  <view wx:if="{{loading && !games.length}}" class="empty-state">正在加载桌游…</view>
  <view wx:elif="{{!loading && !games.length && !loadFailed}}" class="card no-result">
    <text>没有找到符合条件的桌游</text>
    <button class="secondary-button" bindtap="clearAll">清空筛选</button>
  </view>

  <view wx:if="{{loadingMore}}" class="load-more-state">正在加载更多桌游…</view>
  <view wx:elif="{{hasMore && games.length}}" class="load-more-state">继续下滑加载更多</view>
  <view wx:elif="{{games.length}}" class="load-more-state finished">已加载全部桌游</view>

  <view wx:if="{{sourceAttribution}}" class="source-attribution" bindtap="copyBggSource">
    <text>Powered by BGG</text>
    <text class="source-attribution-action">复制来源链接</text>
  </view>

  <ui-nav active="games"/>

  <view wx:if="{{filterOpen}}" class="filter-overlay">
    <view class="filter-scrim" bindtap="closeFilter"></view>
    <view class="filter-sheet" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="sheet-head">
        <text class="sheet-title">{{filterTitle}}</text>
        <text class="sheet-close" bindtap="closeFilter">关闭</text>
      </view>
      <scroll-view class="filter-scroll" scroll-y>
        <view wx:if="{{activeFilter === 'category'}}" class="filter-section">
          <text class="filter-title">常用标签（可多选）</text>
          <text class="filter-helper">默认显示最常用的 12 个标签，也可搜索全部标签</text>
          <input
            class="form-input category-search-input"
            placeholder="搜索标签"
            value="{{categoryQuery}}"
            bindinput="onCategoryQueryInput"
          />
          <text wx:if="{{categoryQuery && categoryOptions.length}}" class="category-match-count">
            匹配到 {{categoryOptions.length}} 个标签，请选择
          </text>
          <text wx:elif="{{categoryQuery}}" class="category-empty-result">没有匹配的标签</text>
          <checkbox-group class="category-options" bindchange="changeCategories">
            <label wx:for="{{categoryViews}}" wx:key="name" class="category-option">
              <checkbox value="{{item.name}}" checked="{{item.selected}}" color="#174f3b" />
              <text>{{item.name}}</text>
            </label>
          </checkbox-group>
        </view>

        <view wx:if="{{activeFilter === 'players'}}" class="filter-section">
          <text class="filter-title">当前有几人</text>
          <text class="filter-helper">选择实际到场人数，将显示支持该人数的桌游</text>
          <view class="player-options">
            <button
              wx:for="{{playerOptions}}"
              wx:key="value"
              class="player-option {{item.selected ? 'selected' : ''}}"
              data-player-count="{{item.value}}"
              bindtap="selectPlayer"
            >{{item.label}}</button>
          </view>
        </view>

        <view wx:if="{{activeFilter === 'minutes'}}" class="filter-section">
          <text class="filter-title">游戏时长</text>
          <range-slider
            min="{{minuteBounds.min}}"
            max="{{minuteBounds.max}}"
            step="{{minuteBounds.step}}"
            lower="{{draftMinutes.lower}}"
            upper="{{draftMinutes.upper}}"
            unit=" 分钟"
            bindchange="changeMinutes"
          />
        </view>

        <view wx:if="{{activeFilter === 'complexity'}}" class="filter-section">
          <text class="filter-title">复杂度</text>
          <range-slider
            min="{{complexityBounds.min}}"
            max="{{complexityBounds.max}}"
            step="{{complexityBounds.step}}"
            lower="{{draftComplexity.lower}}"
            upper="{{draftComplexity.upper}}"
            unit=" / 5"
            bindchange="changeComplexity"
          />
        </view>
      </scroll-view>

      <view class="sheet-actions">
        <button class="clear-button" bindtap="clearDraft">清空</button>
        <button class="apply-button" bindtap="applyFilters">应用筛选</button>
      </view>
    </view>
  </view>
</view>
