.library-page { padding-top: 16rpx; padding-bottom: 130rpx; }

.library-title,
.library-subtitle {
  display: block;
}

.library-title {
  font-size: 44rpx;
  font-weight: 850;
  letter-spacing: 2rpx;
}

.library-subtitle {
  margin-top: 8rpx;
  color: #7f817b;
  font-size: 23rpx;
}

.search-row {
  display: flex;
  gap: 14rpx;
  margin-top: 28rpx;
}

.search-input {
  min-width: 0;
  flex: 1;
  margin: 0;
  background: #fffdf8;
}

.search-button {
  box-sizing: border-box;
  width: 132rpx;
  min-width: 0;
  flex: 0 0 132rpx;
  margin: 0;
  border-radius: 20rpx;
  padding: 0;
  color: #fff;
  background: #174f3b;
  font-size: 25rpx;
  font-weight: 750;
  line-height: 88rpx;
  white-space: nowrap;
}

.quick-filters {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
}

.filter-pill {
  box-sizing: border-box;
  width: auto;
  min-width: 0;
  flex: 1;
  margin: 0;
  border: 1rpx solid #d9d0c2;
  border-radius: 999rpx;
  padding: 0 8rpx;
  color: #385246;
  background: #fffdf8;
  font-size: 22rpx;
  line-height: 64rpx;
}

.selected-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
  margin-top: 18rpx;
}

.selected-chip {
  border-radius: 999rpx;
  padding: 8rpx 15rpx;
  color: #fff;
  background: #52725f;
  font-size: 20rpx;
}

.clear-all {
  color: #9a6b45;
  font-size: 21rpx;
}

.sort-control {
  position: relative;
  display: flex;
  align-items: center;
  margin: 28rpx 4rpx 4rpx;
}

.sort-trigger {
  position: relative;
  z-index: 32;
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 62rpx;
  color: #314038;
  font-size: 26rpx;
  font-weight: 750;
}

.sort-trigger.open {
  color: #52725f;
}

.sort-caret {
  color: #a9aeaa;
  font-size: 16rpx;
}

.sort-trigger.open .sort-caret {
  color: #52725f;
}

.sort-scrim {
  position: fixed;
  z-index: 30;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(22, 29, 25, 0.56);
}

.sort-menu {
  position: absolute;
  z-index: 33;
  top: 100%;
  left: -32rpx;
  box-sizing: border-box;
  width: 100vw;
  border-top: 1rpx solid #eceeea;
  padding: 10rpx 36rpx 18rpx;
  background: #fff;
  box-shadow: 0 18rpx 36rpx rgba(22, 29, 25, 0.12);
}

.sort-menu-item {
  min-height: 94rpx;
  color: #4c5450;
  font-size: 28rpx;
  font-weight: 650;
  line-height: 94rpx;
}

.sort-menu-item.active {
  color: #1c9f8d;
  font-weight: 800;
}

.game-family {
  position: relative;
}

.load-error,
.loading-line {
  margin-top: 18rpx;
  border-radius: 18rpx;
  padding: 18rpx 22rpx;
  text-align: center;
  font-size: 22rpx;
}

.load-error {
  color: #8d4f43;
  background: #f7e8e3;
}

.loading-line {
  color: #54705f;
  background: #eaf1ea;
}

.load-more-state {
  padding: 28rpx 0 12rpx;
  color: #6f7b73;
  text-align: center;
  font-size: 23rpx;
}

.load-more-state.finished {
  color: #9a9c97;
}

.no-result {
  margin-top: 24rpx;
  padding: 46rpx 28rpx;
  color: #7e817b;
  text-align: center;
}

.no-result text {
  display: block;
}

.no-result .secondary-button {
  margin-top: 24rpx;
}

.source-attribution {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  margin: 24rpx 0 8rpx;
  color: #7e817b;
  font-size: 20rpx;
}

.source-attribution-action {
  color: #174f3b;
  text-decoration: underline;
}

.filter-overlay,
.filter-scrim,
.filter-sheet {
  position: fixed;
  z-index: 40;
  right: 0;
  bottom: 0;
  left: 0;
}

.filter-overlay {
  top: 0;
}

.filter-scrim {
  top: 0;
  background: rgba(22, 29, 25, 0.48);
}

.filter-sheet {
  z-index: 41;
  box-sizing: border-box;
  max-height: 86vh;
  border-radius: 34rpx 34rpx 0 0;
  padding: 14rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #fffdf8;
  box-shadow: 0 -18rpx 50rpx rgba(28, 34, 29, 0.16);
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto;
  border-radius: 999rpx;
  background: #d8d0c4;
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 2rpx 16rpx;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 800;
}

.sheet-close {
  color: #777d78;
  font-size: 23rpx;
}

.filter-scroll {
  max-height: 62vh;
}

.filter-section {
  border-top: 1rpx solid #eee5d9;
  padding: 24rpx 0;
}

.filter-title {
  display: block;
  margin-bottom: 16rpx;
  color: #2e3f36;
  font-size: 28rpx;
  font-weight: 750;
}

.filter-helper {
  display: block;
  margin: -4rpx 0 18rpx;
  color: #777f79;
  font-size: 22rpx;
  line-height: 1.55;
}

.player-options {
  display: flex;
  flex-wrap: wrap;
  column-gap: 2.666%;
  row-gap: 14rpx;
}

.player-option {
  box-sizing: border-box;
  width: 23%;
  min-width: 0;
  flex: 0 0 23%;
  margin: 0 !important;
  border: 2rpx solid transparent;
  border-radius: 16rpx;
  padding: 0;
  color: #34443b;
  background: #f0ede7;
  font-size: 27rpx;
  font-weight: 750;
  line-height: 72rpx;
}

.player-option.selected {
  border-color: #174f3b;
  color: #fff;
  background: #174f3b;
}

.category-search-input {
  min-height: 72rpx;
  margin-bottom: 18rpx;
  border-radius: 18rpx;
  font-size: 25rpx;
}

.category-match-count,
.category-empty-result {
  display: block;
  margin: -2rpx 0 16rpx;
  font-size: 22rpx;
}

.category-match-count {
  color: #52725f;
}

.category-empty-result {
  color: #9a6b62;
}

.category-options {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.category-option {
  display: flex;
  align-items: center;
  border: 1rpx solid #e1d8ca;
  border-radius: 16rpx;
  padding: 12rpx 16rpx;
  color: #46544c;
  background: #faf7f0;
  font-size: 24rpx;
}

.category-option checkbox {
  transform: scale(0.75);
  transform-origin: left center;
}

.sheet-actions {
  display: flex;
  gap: 16rpx;
  padding-top: 20rpx;
}

.clear-button,
.apply-button {
  box-sizing: border-box;
  min-width: 0;
  margin: 0;
  border-radius: 22rpx;
  font-size: 25rpx;
  font-weight: 750;
  line-height: 84rpx;
}

.clear-button {
  width: 180rpx;
  flex: 0 0 180rpx;
  color: #174f3b;
  background: #ece7dd;
}

.apply-button {
  width: auto;
  min-width: 0;
  flex: 1;
  color: #fff;
  background: #174f3b;
}

.apply-button[disabled] {
  color: #e7eee9;
  background: #6f8b7b;
}

.recommendation-entry { display: flex; align-items: center; gap: 24rpx; padding: 22rpx; margin-top: 28rpx; margin-bottom: 22rpx; border: 1rpx solid #eeede9; border-radius: 24rpx; background: #fff; }
.recommendation-icon { display: flex; align-items: center; justify-content: center; width: 104rpx; height: 104rpx; flex-shrink: 0; border-radius: 50%; background: #e3f2ec; }
.recommendation-icon image { width: 66rpx; height: 66rpx; }
.recommendation-copy { flex: 1; min-width: 0; }
.recommendation-copy text { display: block; }
.recommendation-title { color: #17211d; font-size: 32rpx; font-weight: 600; }
.recommendation-subtitle { margin-top: 8rpx; color: #81858a; font-size: 24rpx; }
.recommendation-arrow { width: 30rpx; height: 30rpx; flex-shrink: 0; }
