<view class="page-shell expansion-page">
  <view class="base-game" bindtap="goBase"><image wx:if="{{baseCover}}" src="{{baseCover}}" mode="aspectFit" binderror="baseImageError"/><view wx:else class="base-placeholder"><image src="/assets/icons/games-green.svg"/></view><text>所属游戏：<text class="base-name">{{baseGameName}}</text></text><text class="base-arrow">〉</text></view>
  <view class="search-toggle" bindtap="toggleSearch">{{searchOpen ? '收起搜索' : '搜索扩展'}}<image src="/assets/icons/search-muted.svg"/></view>

  <view wx:if="{{searchOpen}}" class="search-row">
    <input
      class="form-input search-input"
      placeholder="搜索扩展名称"
      value="{{query}}"
      bindinput="onQueryInput"
      confirm-type="search"
      bindconfirm="search"
    />
    <button class="search-button" bindtap="search">搜索</button>
  </view>

  <view wx:if="{{searchOpen}}" class="result-head">已展示 {{resultCount}} 个扩展<text class="expansion-subtitle">这里只展示与该基础游戏直接关联的扩展</text></view>
  <view wx:if="{{loadFailed}}" class="load-error" bindtap="retry">加载失败，点击重试</view>

  <board-game-card
    variant="expansion"
    wx:for="{{games}}"
    wx:key="id"
    game="{{item}}"
    bindlike="likeGame"
    bindimageerror="imageError"
  />

  <view wx:if="{{loading && !games.length}}" class="empty-state">正在加载扩展…</view>
  <view wx:elif="{{!loading && !games.length && !loadFailed}}" class="card no-result">没有找到相关扩展</view>
  <view wx:if="{{loadingMore}}" class="load-more-state">正在加载更多扩展…</view>
  <view wx:elif="{{hasMore && games.length}}" class="load-more-state">继续下滑加载更多</view>
  <view wx:elif="{{games.length}}" class="load-more-state finished">已加载全部扩展</view>

  <view wx:if="{{sourceAttribution}}" class="source-attribution" bindtap="copyBggSource">
    <text>Powered by BGG</text>
    <text class="source-attribution-action">复制来源链接</text>
  </view>
</view>
