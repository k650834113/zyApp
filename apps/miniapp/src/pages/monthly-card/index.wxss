@import "../member/index.wxss";
.monthly-card-page{padding-bottom:70rpx}.monthly-card-feature{margin:0;background:linear-gradient(130deg,#1c6650,#154d3c);border:0;border-radius:18rpx;box-shadow:none;padding:36rpx;color:#fff}.monthly-card-feature-title{font-size:40rpx}.monthly-card-eyebrow{font-size:25rpx}.monthly-card-price{font-size:64rpx}.monthly-card-badge{background:#368b6c;color:#fff}.monthly-card-button,.monthly-card-renew-button{width:100%;border-radius:14rpx;line-height:92rpx;font-size:30rpx;background:#fbf7ef;color:#174f3b;margin-top:38rpx}.monthly-card-state{font-size:27rpx;line-height:1.8}.monthly-card-scope-note{font-size:23rpx;line-height:1.8;margin-top:28rpx}.monthly-card-expiry{background:#fff;color:#172029;padding:30rpx;border-radius:14rpx;margin-top:30rpx}.monthly-card-expiry-date{font-size:34rpx}.monthly-card-remaining-days{color:#175540}
.monthly-card-page{padding-bottom:190rpx}.plan-hero{padding:38rpx;background:linear-gradient(135deg,#226e55,#164d3c);border-radius:18rpx;color:white;font-size:27rpx}.plan-hero>view{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.plan-title{font-size:40rpx;font-weight:700}.plan-badge{font-size:24rpx;border-radius:30rpx;background:#348c6b;padding:10rpx 20rpx;white-space:nowrap}.plan-price{display:block;font-size:54rpx;font-weight:700;margin:34rpx 0}.plan-status,.renew-plan{padding:30rpx;background:#fff;border:1rpx solid #e4e5e3;border-radius:16rpx;margin-top:26rpx;font-size:28rpx}.plan-status>view,.renew-plan>view{display:flex;justify-content:space-between;gap:18rpx;margin:12rpx 0}.remaining{display:block;text-align:right;font-size:24rpx;color:#175540}.renew-title{display:block;font-size:34rpx;font-weight:700;margin-top:38rpx}.renew-plan>view{font-size:32rpx;font-weight:700}.renew-plan>view text:last-child{color:#175540}.renew-description{display:block;font-size:26rpx;color:#777;line-height:1.7;margin-top:18rpx}.plan-tip{display:block;padding:24rpx;background:#edf1e8;color:#617068;border-radius:14rpx;font-size:25rpx;line-height:1.7;margin-top:26rpx}.monthly-card-page .purchase-button{position:fixed;bottom:calc(26rpx + env(safe-area-inset-bottom));left:28rpx;width:calc(100% - 56rpx);box-sizing:border-box;border-radius:14rpx}
