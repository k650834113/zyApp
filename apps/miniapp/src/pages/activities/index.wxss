.activities-page { padding: 28rpx 28rpx 40rpx; }
.activity-tabs { display: flex; gap: 18rpx; margin: 0 0 40rpx; }
.activity-tabs button { flex: 1; min-width: 0; margin: 0; padding: 0; border-radius: 28rpx; color: #202722; background: #f3f0e9; font-size: 27rpx; line-height: 70rpx; }
.activity-tabs .active { color: #fff; background: #174f3b; }
.activity-card { overflow: hidden; border: 1rpx solid #e9e7e1; border-radius: 22rpx; background: #fff; margin-bottom: 32rpx; }
.poster { position: relative; height: 262rpx; background: #edf1e7; }
.poster > image { width: 100%; height: 100%; }
.poster-empty { height: 100%; display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 16rpx; color: #788672; font-size: 24rpx; }
.poster-empty image { width: 56rpx; height: 56rpx; }
.poster-title { position: absolute; top: 30rpx; right: 20rpx; width: 200rpx; color: #174f3b; font-size: 44rpx; font-weight: 700; line-height: 1.3; white-space: pre-line; }
.activity-copy { padding: 20rpx; }
.activity-title { display: block; font-size: 32rpx; font-weight: 600; margin-bottom: 18rpx; }
.info { display: flex; align-items: flex-start; gap: 12rpx; color: #666f79; font-size: 25rpx; line-height: 1.5; margin-top: 10rpx; }
.info image { width: 28rpx; height: 30rpx; flex-shrink: 0; }
.summary { display: block; color: #666f79; font-size: 26rpx; line-height: 1.55; margin-top: 12rpx; }
.activity-footer { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 20rpx; }
.tags { display: flex; flex-wrap: wrap; gap: 10rpx; }
.tags text { color: #527c5c; background: #e9f4e6; padding: 8rpx 12rpx; border-radius: 8rpx; font-size: 21rpx; }
.activity-footer button { flex-shrink: 0; margin: 0; padding: 0 28rpx; border-radius: 20rpx; color: #fff; background: #174f3b; font-size: 25rpx; line-height: 68rpx; }

.activity-tabs{gap:12rpx;margin-bottom:26rpx}.activity-tabs button{border:1rpx solid #e4e7dd;background:#fffdf8;font-size:25rpx}.activity-tabs .active{background:#174f3b;border-color:#174f3b}.activity-card{border-color:#e5e8df;border-radius:28rpx;box-shadow:0 8rpx 24rpx rgba(29,64,46,.045);background:#fffdf8}

.poster{height:330rpx}
