.favorites-page {
  padding-top: 24rpx;
}

.favorite-search { display: flex; align-items: center; gap: 20rpx; padding: 20rpx 28rpx; background: #fff; border: 1rpx solid #e9e7e1; border-radius: 30rpx; margin-bottom: 32rpx; }
.favorite-search image { width: 40rpx; height: 40rpx; }
.favorite-search input { min-width: 0; flex: 1; height: 42rpx; font-size: 28rpx; }
.favorites-page .library-button { width: 86%; min-width: 0; margin: 72rpx auto 30rpx; border: 1rpx solid #174f3b; border-radius: 60rpx; background: #fff; color: #174f3b; font-size: 28rpx; line-height: 104rpx; }

.favorites-heading {
  margin-bottom: 28rpx;
}

.page-title,
.page-subtitle,
.empty-favorites text {
  display: block;
}

.page-title {
  font-size: 44rpx;
  font-weight: 850;
}

.page-subtitle {
  margin-top: 8rpx;
  color: #7f817b;
  font-size: 24rpx;
}

.load-error,
.loading-line {
  margin-bottom: 20rpx;
  color: #9b5c47;
  text-align: center;
  font-size: 24rpx;
}

.empty-favorites {
  margin-top: 80rpx;
  padding: 48rpx 32rpx;
  color: #7f817b;
  text-align: center;
}

.empty-favorites .primary-button {
  margin-top: 28rpx;
}
