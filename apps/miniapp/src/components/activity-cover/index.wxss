:host{display:block;width:100%;height:100%}.cover{position:relative;width:100%;height:100%;overflow:hidden;background:linear-gradient(120deg,#fff1d6,#f8db9c);color:#583615}.orb{position:absolute;border:1rpx solid rgba(174,111,34,.14);border-radius:50%}.orb-one{width:390rpx;height:390rpx;right:-130rpx;top:-80rpx}.orb-two{width:290rpx;height:290rpx;right:-80rpx;bottom:-130rpx;background:rgba(255,255,255,.18)}.copy{position:absolute;left:32rpx;top:28rpx;right:190rpx}.eyebrow{display:block;font-size:21rpx;letter-spacing:2rpx;color:#93652f}.title{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;font-size:38rpx;font-weight:700;line-height:1.35;margin-top:16rpx;overflow-wrap:break-word}.date{display:block;font-size:21rpx;margin-top:14rpx;color:#8b673e}.link{display:block;font-size:22rpx;margin-top:18rpx;color:#76501f}.gift{position:absolute;right:34rpx;bottom:55rpx;width:126rpx;height:140rpx;transform:rotate(-10deg)}.box{position:absolute;bottom:0;left:10rpx;width:108rpx;height:86rpx;border-radius:8rpx;background:#cb623d;box-shadow:0 10rpx 20rpx #b4863b22}.lid{position:absolute;left:0;bottom:76rpx;width:128rpx;height:24rpx;border-radius:6rpx;background:#df8050;z-index:1}.ribbon{position:absolute;left:50rpx;bottom:0;width:22rpx;height:100rpx;background:#fff0c0;z-index:2}.spark{position:absolute;top:-26rpx;right:4rpx;font-size:48rpx;color:#a87227}.compact .gift{right:50%;bottom:50%;transform:translate(50%,50%) rotate(-10deg) scale(.7)}.compact .orb-one{width:170rpx;height:170rpx;right:-60rpx;top:-50rpx}

.cover-art{display:block;width:100%;height:100%}
