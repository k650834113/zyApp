:host {
  display: block;
  width: 100%;
}

.game-card {
  position: relative;
  margin-top: 22rpx;
  overflow: hidden;
}

.game-card-body {
  display: flex;
  gap: 22rpx;
  align-items: flex-start;
  padding: 24rpx 142rpx 24rpx 24rpx;
}

.game-cover {
  display: flex;
  width: 150rpx;
  height: 188rpx;
  flex: 0 0 150rpx;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: #e9e0d2;
}

.game-cover-placeholder {
  color: #174f3b;
  font-size: 28rpx;
  font-weight: 800;
}

.game-content {
  min-width: 0;
  flex: 1;
}

.game-name,
.game-meta,
.game-introduction,
.collapse-hint {
  display: block;
}

.game-name {
  padding-right: 6rpx;
  color: #172b22;
  font-size: 34rpx;
  font-weight: 850;
  line-height: 1.35;
}

.category-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.category-tag {
  border-radius: 999rpx;
  padding: 6rpx 13rpx;
  color: #456354;
  background: #edf2ec;
  font-size: 22rpx;
  line-height: 1.4;
}

.category-preview {
  overflow: hidden;
  flex-wrap: nowrap;
}

.category-preview .category-tag {
  overflow: hidden;
  max-width: 126rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-more {
  color: #789084;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.2;
}

.game-meta {
  margin-top: 14rpx;
  color: #3e5549;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.6;
}

.expansion-badge {
  display: inline-block;
  margin-top: 12rpx;
  border-radius: 999rpx;
  padding: 5rpx 13rpx;
  color: #8a5b35;
  background: #f7eadc;
  font-size: 19rpx;
}

.collapse-hint {
  margin-top: 14rpx;
  color: #9a7c50;
  font-size: 22rpx;
  font-weight: 600;
}

.card-actions {
  position: absolute;
  z-index: 3;
  top: 18rpx;
  right: 18rpx;
  bottom: 18rpx;
  display: flex;
  width: 118rpx;
  flex-direction: column;
  align-items: flex-end;
  justify-content: space-between;
}

.game-introduction {
  margin-top: 20rpx;
  color: #4f554f;
  font-size: 25rpx;
  line-height: 1.75;
}

.detail-label {
  display: block;
  color: #253c31;
  font-size: 23rpx;
  font-weight: 800;
}

.introduction-label {
  margin-top: 22rpx;
  margin-bottom: 8rpx;
}

.like-button {
  display: flex;
  box-sizing: border-box;
  width: 92rpx;
  min-width: 92rpx;
  height: 62rpx;
  flex-direction: row;
  gap: 6rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  border-radius: 999rpx;
  padding: 0 10rpx;
  color: #657269;
  background: #f1f4ef;
  line-height: 1;
}

.like-button.liked {
  color: #c76d57;
}

.heart {
  font-size: 34rpx;
}

.like-count {
  font-size: 22rpx;
  font-weight: 700;
}

.expansion-link {
  box-sizing: border-box;
  width: 118rpx;
  min-width: 118rpx;
  margin: 0;
  border-radius: 999rpx;
  padding: 0 6rpx;
  color: #365949;
  background: #e8f0e9;
  font-size: 20rpx;
  font-weight: 750;
  line-height: 50rpx;
  white-space: nowrap;
}
