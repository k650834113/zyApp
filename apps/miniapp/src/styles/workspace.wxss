.workspace-page{padding:32rpx 28rpx 80rpx;color:#243e33;background:#fbf7ef;min-height:100vh;box-sizing:border-box}.heading{display:block;font-size:40rpx;font-weight:700;margin:12rpx 0 28rpx}.card{background:#fff;border:1rpx solid #e6e5da;border-radius:24rpx;padding:28rpx;margin-bottom:24rpx}.section-title{display:block;font-size:30rpx;font-weight:600;margin-bottom:16rpx}.muted{display:block;font-size:24rpx;line-height:1.7;color:#72766c;margin:12rpx 0}.error{display:block;background:#fff0ed;color:#a33327;padding:20rpx;border-radius:16rpx;margin:16rpx 0;font-size:26rpx;white-space:pre-wrap}.workspace-page input,.workspace-page textarea,.picker{background:#f4f4ee;border-radius:14rpx;padding:22rpx;margin:18rpx 0;box-sizing:border-box;width:100%;font-size:28rpx}.workspace-page textarea{height:200rpx}.workspace-page button{margin:16rpx 0;background:#174f3b;color:#fff;border-radius:16rpx;font-size:27rpx}.workspace-page button.secondary{background:#eeeede;color:#174f3b}.entry{display:flex;align-items:center;justify-content:space-between;border-top:1rpx solid #eee;padding:20rpx 0}.entry button{margin:0 0 0 14rpx;flex-shrink:0}.qr-overlay{position:fixed;inset:0;z-index:100;background:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:36rpx;text-align:center}.qr-image{width:600rpx;height:600rpx;max-width:85vw;max-height:45vh}.qr-overlay button{width:80%}.amount{display:block;font-size:34rpx;font-weight:600;margin:20rpx 0}.notice-body{display:block;white-space:pre-wrap;line-height:1.8;font-size:28rpx}.filter-row{display:flex;gap:16rpx}.filter-row picker{flex:1}.unread{color:#b25921}
.workspace-page input{height:88rpx;min-height:88rpx;line-height:44rpx}.workspace-page button{width:100%;min-height:84rpx;line-height:1.5;padding:20rpx 24rpx;box-sizing:border-box}.entry button{width:auto;min-height:60rpx;padding:12rpx 18rpx}.qr-overlay button{width:80%}
