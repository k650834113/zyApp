{
  "name": "@zyapp/merchant-desktop",
  "version": "0.24.2",
  "private": true,
  "description": "ZyApp Windows desktop management and cashier",
  "author": "ZyApp",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "package:win": "pnpm build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "electron-updater": "6.7.3",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "24.13.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "42.4.0",
    "electron-builder": "26.15.2",
    "electron-vite": "5.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.5"
  },
  "build": {
    "appId": "cn.zyapp.cashier",
    "productName": "桌游吧管理收银",
    "asar": true,
    "files": [
      "out/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist-installer"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.invalid/zyapp/windows",
        "channel": "latest"
      }
    ],
    "releaseInfo": {
      "releaseNotesFile": "release-notes.md"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
